{
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": "localhost:6379"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "DefaultConnection",
          "sinkOptionsSection": {
            "tableName": "Logs",
            "autoCreateSqlTable": true
          },
          "columnOptionsSection": {
            "addStandardColumns": [ "LogEvent" ],
            "removeStandardColumns": [ "Properties" ],
            "additionalColumns": [
              {
                "ColumnName": "RequestPath",
                "DataType": "nvarchar",
                "DataLength": 500
              }
            ]
          }
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "JwtSettings": {
    "Audience": "HemenJobBoardPlatform",
    "Issuer": "JobBoardPlatformFinalProject",
    "Secret": "",
    "EncryptKey": "",
    "AccessTokenLifeTime": 15,
    "RefreshTokenLifeTime": 7
  },
  "AdminData": {
    "Role": "Admin",
    "Email": "HemenKarimi8424@Gmail.com",
    "PhoneNumber": "09114945251",
    "Password": ""
  },
  "SmtpSettings": {
    "Server": "smtp.gmail.com",
    "Port": 587,
    "SenderName": "JobBoard Team",
    "SenderEmail": "hemenjobboardplatform@gmail.com",
    "UserName": "hemenjobboardplatform@gmail.com",
    "Password": "",
    "UseSsl": false,
    "DefaultHtml": false
  },
  "AllowedHosts": "*"
}
