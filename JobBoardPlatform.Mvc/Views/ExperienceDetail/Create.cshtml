@model CreateExperienceDetailRequestDto

@{
    ViewData["Title"] = "افزودن سوابق کاری";
}

<div class="card" style="max-width:560px;margin:0 auto;">
    <h3>افزودن سوابق کاری</h3>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="LastJobTitle"></label>
            <input asp-for="LastJobTitle" class="form-control" />
            <span asp-validation-for="LastJobTitle" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="SeniorityLevel"></label>
            <select asp-for="SeniorityLevel" asp-items="ViewBag.SeniorityLevels" class="form-control"></select>
            <span asp-validation-for="SeniorityLevel" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="JobCategory"></label>
            <input asp-for="JobCategory" class="form-control" />
            <span asp-validation-for="JobCategory" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="City"></label>
            <input asp-for="City" class="form-control" />
            <span asp-validation-for="City" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="StartDate"></label>
            <input asp-for="StartDate" class="form-control" type="date" />
            <span asp-validation-for="StartDate" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="EndDate"></label>
            <input asp-for="EndDate" class="form-control" type="date" />
            <span asp-validation-for="EndDate" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="IsCurrentJob">
                <input asp-for="IsCurrentJob" />
                شغل فعلی
            </label>
        </div>

        <button type="submit" class="btn">ثبت</button>
    </form>
</div>
