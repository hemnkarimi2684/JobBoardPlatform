@model ExperienceDetailCreateViewModel

@{
    ViewData["Title"] = "Add Work Experience";
}

<div class="page-head">
    <div>
        <h1 class="page-title">Add Work Experience</h1>
        <p class="subtitle">Add an entry to your work history.</p>
    </div>
    <a class="btn btn-ghost" asp-action="Index">&#8592; Back to Work Experience</a>
</div>

<div class="card auth-card" style="max-width: 620px;">
    <h3>Add Work Experience</h3>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="LastJobTitle">Job Title</label>
            <input asp-for="LastJobTitle" class="form-control" placeholder="e.g., Senior ASP.NET Developer" />
            <span asp-validation-for="LastJobTitle" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="SeniorityLevel">Seniority Level</label>
            <select asp-for="SeniorityLevel" asp-items="ViewBag.SeniorityLevels" class="form-control">
                <option value="">-- Select Seniority Level --</option>
            </select>
            <span asp-validation-for="SeniorityLevel" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="JobCategory">Job Category</label>
            <input asp-for="JobCategory" class="form-control" placeholder="e.g., Software Engineering" />
            <span asp-validation-for="JobCategory" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="City">City</label>
            <input asp-for="City" class="form-control" placeholder="e.g., Tehran" />
            <span asp-validation-for="City" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="StartDate">Start Date</label>
            <input asp-for="StartDate" class="form-control" type="date" />
            <span asp-validation-for="StartDate" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="EndDate">End Date</label>
            <input asp-for="EndDate" class="form-control" type="date" />
            <span asp-validation-for="EndDate" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label class="form-check">
                <input asp-for="IsCurrentJob" />
                <span>This is my current job</span>
            </label>
        </div>

        <button type="submit" class="btn btn-primary">Save Experience</button>
    </form>
</div>
