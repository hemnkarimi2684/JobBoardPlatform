@model UserProfileResponseDto

@{
    ViewData["Title"] = "پروفایل من";
    var email = User.FindFirst(ClaimTypes.Email)?.Value;
}

<h2 style="margin-bottom: 18px; color: #1e3a5f;">پروفایل من</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert" style="background:#fdecea;color:#b3392f;border:1px solid #f5c6c2;">@TempData["Error"]</div>
}

@if (string.IsNullOrWhiteSpace(Model.FullName))
{
    <div class="card">
        <div class="empty">پروفایل کاربری شما هنوز تکمیل نشده است.</div>
        <div style="text-align:center;margin-top:10px;">
            <a class="btn" asp-action="Create">ساخت پروفایل</a>
        </div>
    </div>
}
else
{
    <div class="card">
        <h3>@Model.FullName</h3>
        @if (Model.UserImageFileId != null)
        {
            <div style="margin-bottom: 14px;">
                <img src="@Url.Action("DownloadImage", "User")" alt="@Model.FullName" style="max-width:160px;border-radius:10px;" />
            </div>
        }
        <div class="detail-grid">
            <div><span>نام و نام خانوادگی</span> @Model.FullName</div>
            <div><span>جنسیت</span> @Model.Gender</div>
            <div><span>تاریخ تولد</span> @Model.BirthDate.ToString("yyyy/MM/dd")</div>
            <div><span>شهر</span> @Model.CityName</div>
            <div><span>نشانی</span> @Model.Address</div>
            <div><span>ایمیل</span> @email</div>
            <div><span>درباره من</span> @Model.Bio</div>
        </div>
        <div style="margin-top: 16px;">
            <a class="btn" asp-action="Edit">ویرایش پروفایل</a>
        </div>
    </div>

    <div class="card">
        <h3>عکس پروفایل</h3>
        <form asp-action="UploadImage" method="post" enctype="multipart/form-data" style="margin-bottom: 12px;">
            <div class="form-group">
                <input type="file" name="Image" class="form-control" />
            </div>
            <button type="submit" class="btn">آپلود عکس</button>
        </form>
        @if (Model.UserImageFileId != null)
        {
            <form asp-action="DeleteImage" method="post">
                <button type="submit" class="btn">حذف عکس</button>
            </form>
        }
    </div>
}
