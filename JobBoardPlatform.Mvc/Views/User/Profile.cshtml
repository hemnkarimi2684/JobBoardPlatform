@model UserProfileViewModel

@{
    ViewData["Title"] = "My Profile";
    var email = User.FindFirst(ClaimTypes.Email)?.Value;
}

<div class="detail-hero">
    <div class="detail-hero-main">
        @if (Model.UserImageFileId != null)
        {
            <div class="detail-hero-icon" style="background:#fff; padding:6px; box-sizing:border-box;">
                <img src="@Url.Action("DownloadImage", "User")" alt="@Model.FullName" style="width:100%; height:100%; object-fit:cover; border-radius:10px;" />
            </div>
        }
        else
        {
            <div class="detail-hero-icon">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" /></svg>
            </div>
        }
        <div>
            <h1 class="detail-hero-title">@(string.IsNullOrWhiteSpace(Model.FullName) ? "My Profile" : Model.FullName)</h1>
            <div class="detail-hero-meta">
                <span>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" /></svg>
                    @email
                </span>
            </div>
        </div>
    </div>
    <div class="detail-hero-actions">
        <a class="btn btn-primary" asp-action="Edit">Edit Profile</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (string.IsNullOrWhiteSpace(Model.FullName))
{
    <div class="empty-state">
        <div class="empty-icon">&#128100;</div>
        <h3>Profile not complete</h3>
        <p>Your user profile is not yet complete.</p>
        <a class="btn btn-primary" asp-action="Create">Create Profile</a>
    </div>
}
else
{
    <section class="panel">
        @if (Model.UserImageFileId != null)
        {
            <div style="margin-bottom: 16px;">
                <img src="@Url.Action("DownloadImage", "User")" alt="@Model.FullName" class="company-logo" />
            </div>
        }
        <div class="detail-grid">
            <div class="detail-item">
                <span class="detail-label">Full Name</span>
                <span class="detail-value">@Model.FullName</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Gender</span>
                <span class="detail-value">@Model.Gender</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Date of Birth</span>
                <span class="detail-value">@Model.BirthDate.ToString("yyyy/MM/dd")</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">City</span>
                <span class="detail-value">@Model.CityName</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Address</span>
                <span class="detail-value">@Model.Address</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Email</span>
                <span class="detail-value">@email</span>
            </div>
        </div>
        <div class="bio">
            <h3>About Me</h3>
            <p>@Model.Bio</p>
        </div>
    </section>

    <section class="panel">
        <div class="panel-head">
            <h3>Profile Picture</h3>
        </div>
        <form asp-action="UploadImage" method="post" enctype="multipart/form-data" style="margin-bottom: 12px;">
            <div class="form-group">
                <input type="file" name="Image" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary">Upload Photo</button>
        </form>
        @if (Model.UserImageFileId != null)
        {
            <form asp-action="DeleteImage" method="post">
                <button type="submit" class="btn btn-danger">Delete Photo</button>
            </form>
        }
    </section>
}
