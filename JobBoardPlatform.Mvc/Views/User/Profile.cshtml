@model UserProfileViewModel

@{
    ViewData["Title"] = "My Profile";
    var email = User.FindFirst(ClaimTypes.Email)?.Value;
}

<div class="page-head">
    <div>
        <h1 class="page-title">My Profile</h1>
        <p class="subtitle">@email</p>
    </div>
    <a class="btn btn-outline" asp-action="Edit">Edit Profile</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (string.IsNullOrWhiteSpace(Model.FullName))
{
    <div class="empty-state">
        <div class="empty-icon">&#128100;</div>
        <h3>Profile not complete</h3>
        <p>Your user profile is not yet complete.</p>
        <a class="btn btn-primary" asp-action="Create">Create Profile</a>
    </div>
}
else
{
    <section class="panel">
        @if (Model.UserImageFileId != null)
        {
            <div style="margin-bottom: 16px;">
                <img src="@Url.Action("DownloadImage", "User")" alt="@Model.FullName" class="company-logo" />
            </div>
        }
        <div class="detail-grid">
            <div class="detail-item">
                <span class="detail-label">Full Name</span>
                <span class="detail-value">@Model.FullName</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Gender</span>
                <span class="detail-value">@Model.Gender</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Date of Birth</span>
                <span class="detail-value">@Model.BirthDate.ToString("yyyy/MM/dd")</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">City</span>
                <span class="detail-value">@Model.CityName</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Address</span>
                <span class="detail-value">@Model.Address</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Email</span>
                <span class="detail-value">@email</span>
            </div>
        </div>
        <div class="bio">
            <h3>About Me</h3>
            <p>@Model.Bio</p>
        </div>
    </section>

    <section class="panel">
        <div class="panel-head">
            <h3>Profile Picture</h3>
        </div>
        <form asp-action="UploadImage" method="post" enctype="multipart/form-data" style="margin-bottom: 12px;">
            <div class="form-group">
                <input type="file" name="Image" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary">Upload Photo</button>
        </form>
        @if (Model.UserImageFileId != null)
        {
            <form asp-action="DeleteImage" method="post">
                <button type="submit" class="btn btn-danger">Delete Photo</button>
            </form>
        }
    </section>
}
