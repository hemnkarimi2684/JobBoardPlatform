@model HomeViewModel

@{
    ViewData["Title"] = "Home";
    var allCategories = ViewBag.JobCategories as IEnumerable<SelectListItem>;
}

<section class="hero">
    <div class="hero-content">
        <span class="hero-eyebrow">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 0 0 .75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 0 0-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0 1 12 15c-2.743 0-5.357-.467-7.827-1.47-.254-.085-.48-.215-.673-.38m0 0A2.18 2.18 0 0 1 3 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 0 1 3.413-.387m16.5 0V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 0 0-3.413-.387m-7.5 0a48.114 48.114 0 0 1 3.413-.387m-7.5 0c.106.97.505 1.85 1.162 2.554m-1.162-2.554a11.986 11.986 0 0 0-4.252.06M18 4.5A3 3 0 0 1 21 7.5m-3-3A3 3 0 0 0 15 7.5m3-3A3 3 0 0 1 18 7.5" /></svg>
            JobBoard
        </span>
        <h1>Find your next job</h1>
        <p>Discover active job advertisements posted by trusted companies and take the next step in your career.</p>
    </div>
</section>

<div class="search-panel">
    <form asp-controller="Home" asp-action="Index" method="get" class="search-form">
        <div class="search-row">
            <div class="search-box">
                <span class="search-icon">&#128269;</span>
                <input type="text" name="searchTerm" value="@Model.SearchTerm"
                       class="search-input" placeholder="Job title, company or city..." />
            </div>
            <button type="submit" class="btn btn-primary btn-lg">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" /></svg>
                Search
            </button>
        </div>

        <div class="filter-row">
            <div class="field">
                <label for="jobCategoryId">Category</label>
                <select id="jobCategoryId" name="jobCategoryId" class="form-control">
                    <option value="">All categories</option>
                    @foreach (var category in allCategories)
                    {
                        <option value="@category.Value" selected="@(Model.JobCategoryId?.ToString() == category.Value)">
                            @category.Text
                        </option>
                    }
                </select>
            </div>

            <div class="field">
                <label for="collaborationType">Work type</label>
                <select id="collaborationType" name="collaborationType" class="form-control">
                    <option value="">All types</option>
                    @foreach (var type in ViewBag.CollaborationTypes)
                    {
                        <option value="@type.Value" selected="@(((int?)Model.CollaborationType)?.ToString() == type.Value)">
                            @type.Text
                        </option>
                    }
                </select>
            </div>

            <div class="field">
                <label for="minimumSalary">Min salary</label>
                <input type="number" id="minimumSalary" name="minimumSalary" value="@Model.MinimumSalary"
                       class="form-control" placeholder="0" />
            </div>

            <div class="field">
                <label for="maximumSalary">Max salary</label>
                <input type="number" id="maximumSalary" name="maximumSalary" value="@Model.MaximumSalary"
                       class="form-control" placeholder="No limit" />
            </div>

            <div class="field field-actions">
                <a asp-controller="Home" asp-action="Index" class="btn btn-ghost">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
                    Clear
                </a>
            </div>
        </div>
    </form>
</div>

<div class="section-head">
    <div class="section-head-copy">
        <h2>
            <span class="section-icon">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 0 0 .75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 0 0-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0 1 12 15c-2.743 0-5.357-.467-7.827-1.47-.254-.085-.48-.215-.673-.38m0 0A2.18 2.18 0 0 1 3 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 0 1 3.413-.387m16.5 0V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 0 0-3.413-.387m-7.5 0a48.114 48.114 0 0 1 3.413-.387m-7.5 0c.106.97.505 1.85 1.162 2.554m-1.162-2.554a11.986 11.986 0 0 0-4.252.06M18 4.5A3 3 0 0 1 21 7.5m-3-3A3 3 0 0 0 15 7.5m3-3A3 3 0 0 1 18 7.5" /></svg>
            </span>
            @(Model.HasActiveCriteria ? "Search Results" : "Latest Jobs")
        </h2>
        <p>@(Model.HasActiveCriteria ? "Matching your search criteria" : "Recently posted opportunities")</p>
    </div>
    <div class="section-head-actions">
        <a class="btn btn-outline btn-sm" asp-controller="Advertisement" asp-action="Index">Browse All Ads</a>
    </div>
</div>

@if (Model.Data.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon">&#128269;</div>
        <h3>No jobs found</h3>
        <p>Try adjusting your search or clearing the filters.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
            Clear filters
        </a>
    </div>
}
else
{
    <div class="job-grid">
        @foreach (var item in Model.Data)
        {
            <article class="job-card">
                <div class="job-card-top">
                    @if (item.CompanyImageFileId.HasValue)
                    {
                        <div class="job-logo" style="overflow:hidden;">
                            <img src="@Url.Action("DownloadImage", "Company", new { id = item.CompanyId })" alt="@item.CompanyName" style="width:100%; height:100%; object-fit:cover;" />
                        </div>
                    }
                    else
                    {
                        <div class="job-logo">
                            @(string.IsNullOrEmpty(item.CompanyName) ? "?" : item.CompanyName.Substring(0, 1))
                        </div>
                    }
                    <div class="job-heading">
                        <h3 class="job-title">
                            <a asp-controller="Advertisement" asp-action="Details" asp-route-id="@item.AdvertisementId">
                                @item.JobName
                            </a>
                        </h3>
                        <div class="job-company">@item.CompanyName</div>
                    </div>
                    @if (item.IsFeatured)
                    {
                        <span class="badge badge-featured">Featured</span>
                    }
                </div>

                <div class="job-meta">
                    <span>&#128205; @item.CityName</span>
                    <span>&#128197; @item.CreatedAt.ToString("MMM yyyy")</span>
                </div>

                <div class="job-badges">
                    <span class="badge">@item.CollaborationType</span>
                    @if (item.ExperienceLevel > 0)
                    {
                        <span class="badge badge-outline">@item.ExperienceLevel yrs exp</span>
                    }
                    @if (item.MinimumSalary > 0 || item.MaximumSalary > 0)
                    {
                        <span class="badge badge-salary">
                            &#128176; @item.MinimumSalary.ToString("#,##0") - @item.MaximumSalary.ToString("#,##0")
                        </span>
                    }
                </div>

                <p class="job-desc">
                    @(item.Description.Length > 120 ? item.Description.Substring(0, 120) + "..." : item.Description)
                </p>

                <a class="btn btn-outline btn-block"
                   asp-controller="Advertisement" asp-action="Details" asp-route-id="@item.AdvertisementId">
                    View Details
                </a>
            </article>
        }
    </div>

    if (Model.TotalPageCount > 1)
    {
        <nav class="pager">
            @if (Model.PageNumber > 1)
            {
                <a class="pager-link"
                   asp-controller="Home" asp-action="Index"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-jobCategoryId="@Model.JobCategoryId"
                   asp-route-collaborationType="@((int?)Model.CollaborationType)"
                   asp-route-minimumSalary="@Model.MinimumSalary"
                   asp-route-maximumSalary="@Model.MaximumSalary"
                   asp-route-pageNumber="@(Model.PageNumber - 1)">&#8592; Previous</a>
            }
            <span class="pager-current">Page @Model.PageNumber of @Model.TotalPageCount</span>
            @if (Model.PageNumber < Model.TotalPageCount)
            {
                <a class="pager-link"
                   asp-controller="Home" asp-action="Index"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-jobCategoryId="@Model.JobCategoryId"
                   asp-route-collaborationType="@((int?)Model.CollaborationType)"
                   asp-route-minimumSalary="@Model.MinimumSalary"
                   asp-route-maximumSalary="@Model.MaximumSalary"
                   asp-route-pageNumber="@(Model.PageNumber + 1)">Next &#8594;</a>
            }
        </nav>
    }
}

<div class="cta-card">
    <div>
        <h3>Are you hiring?</h3>
        <p>Post a job advertisement and reach qualified candidates in minutes.</p>
    </div>
    <a class="btn btn-primary" asp-controller="Account" asp-action="RegisterEmployer">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
        Post a Job
    </a>
</div>
