@{
    ViewData["Title"] = "Page Not Found";
}

<div class="text-center mt-5">
    <h1 class="text-warning">404</h1>
    <h2 class="mb-3">Page Not Found</h2>
    <p class="text-muted">The page you are looking for may have been removed, renamed, or is temporarily unavailable.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Back to Home</a>
</div>