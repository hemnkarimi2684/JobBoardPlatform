@model SkillMySkillsViewModel

@{
    ViewData["Title"] = "My Skills";
    var availableSkills = Model.AvailableSkills;
}

<div class="page-head">
    <div>
        <h1 class="page-title">My Skills</h1>
        <p class="subtitle">Manage the skills on your resume.</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<section class="panel">
    <div class="panel-head">
        <h3>Earned Skills</h3>
    </div>
    @if (Model.Data.Count == 0)
    {
        <p class="meta">You haven't added any skills yet.</p>
    }
    else
    {
        <div class="chips" style="justify-content: flex-start;">
            @foreach (var skill in Model.Data)
            {
                <div class="chip" style="gap: 6px;">
                    @skill.SkillName
                    <form asp-action="RemoveSkill" method="post" style="display: inline;" onsubmit="return confirm('Are you sure you want to remove this skill?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="skillsId" value="@skill.SkillId" />
                        <button type="submit" class="chip-remove" title="Remove @skill.SkillName" aria-label="Remove @skill.SkillName">&times;</button>
                    </form>
                </div>
            }
        </div>
    }
</section>

@if (availableSkills.Count > 0)
{
    <section class="panel">
        <div class="panel-head">
            <h3>Add Skill</h3>
        </div>
        <form asp-action="Assign" method="post">
            <div class="chips" style="justify-content: flex-start; margin-bottom: 16px;">
                @foreach (var skill in availableSkills)
                {
                    <label class="form-check">
                        <input type="checkbox" name="skillsId" value="@skill.SkillId" />
                        <span>@skill.SkillName</span>
                    </label>
                }
            </div>
            <button type="submit" class="btn btn-primary">Add Skill</button>
        </form>
    </section>
}
else
{
    <div class="empty-state">
        <div class="empty-icon">&#10003;</div>
        <h3>All skills added</h3>
        <p>No more skills to add.</p>
    </div>
}
