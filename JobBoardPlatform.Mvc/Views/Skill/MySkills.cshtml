@model SkillMySkillsViewModel

@{
    ViewData["Title"] = "My Skills";
    var availableSkills = Model.AvailableSkills;
}

<h2 style="margin-bottom: 18px; color: #1e3a5f;">My Skills</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    // Using the alert-danger class defined in _Layout.cshtml for consistency
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card">
    <h3>Earned Skills</h3>
    @if (Model.Data.Count == 0)
    {
        <div class="empty">You haven't added any skills yet.</div>
    }
    else
    {
        <div style="display: flex; flex-wrap: wrap; gap: 6px;">
            @* Added flex wrap for better display of skills *@
            @foreach (var skill in Model.Data)
            {
                <span class="skill">@skill.SkillName</span>
            }
        </div>
    }
</div>

@if (availableSkills.Count > 0)
{
    <div class="card">
        <h3>Add Skill</h3>
        <form asp-action="Assign" method="post">
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 10px; margin-bottom: 15px;">
                @* Using grid for checkboxes *@
                @foreach (var skill in availableSkills)
                {
                    <label style="display: block; margin-bottom: 8px; align-items: center; display: flex;">
                        @* Aligned items to center vertically *@
                        <input type="checkbox" name="skillsId" value="@skill.SkillId" style="margin-right: 8px;" /> @* Added margin-right for LTR checkbox spacing *@
                        @skill.SkillName
                    </label>
                }
            </div>
            <button type="submit" class="btn">Add Skill</button>
        </form>
    </div>
}
else
{
    <div class="empty">No more skills to add.</div>
}
