@model Pagination<UserSkillResponseDto>

@{
    ViewData["Title"] = "مهارت‌های من";
    var availableSkills = (List<SkillDetailResponseDto>)ViewBag.AvailableSkills;
}

<h2 style="margin-bottom: 18px; color: #1e3a5f;">مهارت‌های من</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert" style="background:#fdecea;color:#b3392f;border:1px solid #f5c6c2;">@TempData["Error"]</div>
}

<div class="card">
    <h3>مهارت‌های کسب‌شده</h3>
    @if (Model.Data.Count == 0)
    {
        <div class="empty">هنوز مهارتی ندارید.</div>
    }
    else
    {
        <div>
            @foreach (var skill in Model.Data)
            {
                <span class="skill">@skill.SkillName</span>
            }
        </div>
    }
</div>

@if (availableSkills.Count > 0)
{
    <div class="card">
        <h3>افزودن مهارت</h3>
        <form asp-action="Assign" method="post">
            @foreach (var skill in availableSkills)
            {
                <label style="display:block;margin-bottom:8px;">
                    <input type="checkbox" name="skillsId" value="@skill.SkillId" />
                    @skill.SkillName
                </label>
            }
            <button type="submit" class="btn">افزودن مهارت</button>
        </form>
    </div>
}
else
{
    <div class="empty">مهارت دیگری برای افزودن وجود ندارد.</div>
}
