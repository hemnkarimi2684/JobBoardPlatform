@model SkillIndexViewModel
@{
    ViewData["Title"] = "Skills";
}

<div class="page-head">
    <div>
        <h1 class="page-title">Skills</h1>
        <p class="subtitle">Browse available skills.</p>
    </div>
</div>

<div class="panel">
    <form asp-action="Index" method="get" class="search-row">
        <div class="search-box" style="flex: 1;">
            <span class="search-icon">&#128269;</span>
            <input type="text" name="text" value="@ViewBag.Text" class="search-input" placeholder="Search skills" />
        </div>
        <button type="submit" class="btn btn-primary">Search</button>
    </form>
</div>

@if (Model.Data.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon">&#128269;</div>
        <h3>No skills found</h3>
        <p>Try a different search term.</p>
    </div>
}
else
{
    <div class="panel">
        <div class="chips" style="justify-content: flex-start;">
            @foreach (var skill in Model.Data)
            {
                <span class="chip">@skill.SkillName</span>
            }
        </div>
    </div>

    <partial name="_Pager" model="@Model" />
}
