@model CityDetailsViewModel

@{
    ViewData["Title"] = "Companies in City";
}

<div class="detail-hero">
    <div class="detail-hero-main">
        <div class="detail-hero-icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" /></svg>
        </div>
        <div>
            <h1 class="detail-hero-title">Companies in City</h1>
            <div class="detail-hero-meta">
                <span>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21" /></svg>
                    Companies located in this city
                </span>
            </div>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (Model.Data.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon">&#128269;</div>
        <h3>No companies found</h3>
        <p>No companies were found in this city.</p>
    </div>
}
else
{
    <div class="job-list">
        @foreach (var item in Model.Data)
        {
            <div class="card card-hover">
                <div class="card-between">
                    <h3 style="margin-bottom: 0;">@item.CompanyName</h3>
                    <a class="btn btn-outline" asp-controller="Company" asp-action="Details" asp-route-id="@item.CompanyId">View Company Details</a>
                </div>
                <div class="meta" style="margin-top: 10px;">
                    @item.CityName &nbsp;|&nbsp; @item.JobCategoryName
                </div>
                <p style="margin: 10px 0; color: var(--muted);">
                    @(item.AboutUs.Length > 120 ? item.AboutUs.Substring(0, 120) + "..." : item.AboutUs)
                </p>
            </div>
        }
    </div>

    @await Html.PartialAsync("_Pager", Model)
}
