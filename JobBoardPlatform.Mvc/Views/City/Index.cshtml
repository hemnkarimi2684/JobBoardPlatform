@model Pagination<CityDetailResponseDto>

@{
    ViewData["Title"] = "Cities";
}

<div style="direction: ltr; text-align: left;">
    <h2 style="margin-bottom: 18px; color: #1e3a5f;">List of Cities</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert" style="background:#fdecea; color:#a43d3d; border:1px solid #f5c6cb;">@TempData["Error"]</div>
    }

    <form asp-action="Index" method="get" style="margin-bottom: 18px;">
        <div class="form-group" style="display:flex; gap:8px; margin-bottom:0;">
            <input type="text" name="text" value="@ViewBag.Text" class="form-control" placeholder="Search cities..." />
            <button type="submit" class="btn">Search</button>
        </div>
    </form>

    @if (Model.Data.Count == 0)
    {
        <div class="empty">No cities found.</div>
    }
    else
    {
        foreach (var item in Model.Data)
        {
            <div class="card">
                <h3>@item.CityName</h3>
                <div class="meta" style="color: #666; margin-bottom: 10px;">@item.ProvinceName</div>
                <a class="btn" asp-action="Details" asp-route-id="@item.CityId">Details</a>
            </div>
        }

        @await Html.PartialAsync("_Pager", Model)
    }
</div>
