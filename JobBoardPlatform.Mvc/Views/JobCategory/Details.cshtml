@model JobCategoryDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
}

<div class="page-head">
    <h1 class="page-title">@Model.Name</h1>
    <p class="subtitle">Category details</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card">
    @if (Model.Jobs.Count > 0)
    {
        <h3>Jobs in this category</h3>
        <div class="chips" style="margin-top: 10px;">
            @foreach (var job in Model.Jobs)
            {
                <span class="chip">@job.Name</span>
            }
        </div>
    }
    else
    {
        <p class="meta">No jobs have been registered for this category yet.</p>
    }

    <div style="margin-top: 18px;">
        <a class="btn btn-outline" asp-action="Index">Back to List</a>
    </div>
</div>
