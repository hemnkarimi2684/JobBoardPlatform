@model JobCategoryDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    // Using the standard danger alert for errors.
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card">
    <h3>@Model.Name</h3>

    @if (Model.Jobs.Count > 0)
    {
        <h4 style="margin: 16px 0 8px; color: #1e3a5f;">Jobs in this category</h4>
        <div>
            @foreach (var job in Model.Jobs)
            {
                <span class="skill">@job.Name</span>
            }
        </div>
    }
    else
    {
        <p class="meta" style="margin-top: 10px;">No jobs have been registered for this category yet.</p>
    }

    <div style="margin-top: 18px;">
        <a class="btn" asp-action="Index">Back to List</a>
    </div>
</div>
