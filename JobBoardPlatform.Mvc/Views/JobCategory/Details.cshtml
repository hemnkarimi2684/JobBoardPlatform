@model JobCategoryDetailResponseDto

@{
    ViewData["Title"] = Model.Name;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert" style="background:#fdecea;color:#a43d3d;border:1px solid #f5c6cb;">@TempData["Error"]</div>
}

<div class="card">
    <h3>@Model.Name</h3>

    @if (Model.Jobs.Count > 0)
    {
        <h4 style="margin: 16px 0 8px; color: #1e3a5f;">شغل‌های این دسته‌بندی</h4>
        <div>
            @foreach (var job in Model.Jobs)
            {
                <span class="skill">@job.Name</span>
            }
        </div>
    }
    else
    {
        <p class="meta" style="margin-top: 10px;">در حال حاضر شغلی برای این دسته‌بندی ثبت نشده است.</p>
    }

    <div style="margin-top: 18px;">
        <a class="btn" asp-action="Index">بازگشت به لیست</a>
    </div>
</div>
