@model JobCategoryIndexViewModel

@{
    ViewData["Title"] = "Job Categories";
    // Retrieve the search text from ViewBag, defaulting to empty string if not present.
    var searchText = ViewBag.Text as string ?? "";
}

<div class="page-head">
    <h1 class="page-title">Job Categories</h1>
    <p class="subtitle">Explore job categories and find what interests you.</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="panel">
    <form asp-action="Index" method="get" class="search-row">
        <div class="search-box" style="flex: 1;">
            <span class="search-icon">&#128269;</span>
            <input type="text" name="text" value="@searchText" class="search-input" placeholder="Search category..." />
        </div>
        <button type="submit" class="btn btn-primary">Search</button>
    </form>
</div>

@if (Model.Data.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon">&#128269;</div>
        <h3>No categories found</h3>
        <p>Try a different search term.</p>
    </div>
}
else
{
    <div class="job-list">
        @foreach (var item in Model.Data)
        {
            <div class="card card-hover card-between">
                <h3 style="margin-bottom: 0;">@item.Name</h3>
                <a class="btn btn-outline" asp-action="Details" asp-route-id="@item.JobCategoryId">Details</a>
            </div>
        }
    </div>

    @await Html.PartialAsync("_Pager", Model)
}
