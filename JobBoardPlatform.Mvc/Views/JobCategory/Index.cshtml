@model Pagination<JobCategoryResponseDto>

@{
    ViewData["Title"] = "دسته‌بندی‌های شغلی";
}

<h2 style="margin-bottom: 18px; color: #1e3a5f;">لیست دسته‌بندی‌های شغلی</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert" style="background:#fdecea;color:#a43d3d;border:1px solid #f5c6cb;">@TempData["Error"]</div>
}

<form asp-action="Index" method="get" style="margin-bottom: 18px;">
    <div class="form-group" style="display:flex;gap:8px;margin-bottom:0;">
        <input type="text" name="text" value="@ViewBag.Text" class="form-control" placeholder="جستجوی دسته‌بندی..." />
        <button type="submit" class="btn">جستجو</button>
    </div>
</form>

@if (Model.Data.Count == 0)
{
    <div class="empty">دسته‌بندی‌ای یافت نشد.</div>
}
else
{
    foreach (var item in Model.Data)
    {
        <div class="card">
            <h3>@item.Name</h3>
            <a class="btn" asp-action="Details" asp-route-id="@item.JobCategoryId">جزئیات</a>
        </div>
    }

    @await Html.PartialAsync("_Pager", Model);
}
