@model JobCategoryIndexViewModel

@{
    ViewData["Title"] = "Job Categories";
    // Retrieve the search text from ViewBag, defaulting to empty string if not present.
    var searchText = ViewBag.Text as string ?? "";
}

<div style="direction: ltr; text-align: left;">
    <h2 style="margin-bottom: 18px; color: #1e3a5f;">Job Categories List</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        // Using the standard danger alert for errors.
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form asp-action="Index" method="get" style="margin-bottom: 18px;">
        <div class="form-group" style="display:flex; gap:8px; margin-bottom:0;">
            <input type="text" name="text" value="@searchText" class="form-control" placeholder="Search category..." />
            <button type="submit" class="btn">Search</button>
        </div>
    </form>

    @if (Model.Data.Count == 0)
    {
        <div class="empty">No categories found.</div>
    }
    else
    {
        foreach (var item in Model.Data)
        {
            <div class="card">
                <h3>@item.Name</h3>
                <a class="btn" asp-action="Details" asp-route-id="@item.JobCategoryId">Details</a>
            </div>
        }

        @await Html.PartialAsync("_Pager", Model)
    ;
    }
</div>
