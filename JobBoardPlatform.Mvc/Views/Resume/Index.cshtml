@model ResumeDetailResponseDto

@{
    ViewData["Title"] = "رزومه من";
}

<h2 style="margin-bottom: 18px; color: #1e3a5f;">رزومه من</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert" style="background:#fdecea;color:#b3392f;border:1px solid #f5c6c2;">@TempData["Error"]</div>
}

@if (Model.ResumeId is null)
{
    <div class="card">
        <div class="empty">هنوز رزومه‌ای نساخته‌اید.</div>
        <div style="text-align:center;margin-top:10px;">
            <a class="btn" asp-action="Create">ساخت رزومه</a>
        </div>
    </div>
    <div style="margin-top: 14px; text-align: center; font-size: .9rem;">
        <a asp-controller="User" asp-action="Create">تکمیل پروفایل کاربری</a> |
        <a asp-controller="Skill" asp-action="MySkills">مدیریت مهارت‌ها</a>
    </div>
}
else
{
    <div class="card">
        <h3>@Model.Title</h3>
        @if (Model.ResumeUserProfiles != null)
        {
            <div class="meta">@Model.ResumeUserProfiles.FullName</div>
            <p style="color:#445;">@Model.ResumeUserProfiles.Bio</p>
        }
    </div>

    @if (Model.ResumeEducationDetails.Count > 0)
    {
        <div class="card">
            <h3>سوابق تحصیلی</h3>
            @foreach (var edu in Model.ResumeEducationDetails)
            {
                <div style="padding: 8px 0; border-bottom: 1px solid #eef;">
                    <strong>@edu.Major</strong> - @edu.University
                    <div class="meta">@edu.CertificateDegreeName | @edu.StartDate.ToString("yyyy/MM")</div>
                </div>
            }
        </div>
    }

    @if (Model.ResumeExperienceDetails.Count > 0)
    {
        <div class="card">
            <h3>سوابق کاری</h3>
            @foreach (var exp in Model.ResumeExperienceDetails)
            {
                <div style="padding: 8px 0; border-bottom: 1px solid #eef;">
                    <strong>@exp.LastJobTitle</strong>
                    <div class="meta">@exp.JobCategory | @exp.City | @exp.SeniorityLevel</div>
                </div>
            }
        </div>
    }

    @if (Model.ResumeSkills.Count > 0)
    {
        <div class="card">
            <h3>مهارت‌ها</h3>
            <div>
                @foreach (var skill in Model.ResumeSkills)
                {
                    <span class="skill">@skill.SkillName</span>
                }
            </div>
        </div>
    }

    <div class="card">
        <h3>فایل رزومه</h3>
        @if (Model.ResumeFileId != null)
        {
            <div style="margin-bottom: 12px;">
                <a class="btn" asp-action="Download" asp-route-resumeId="@Model.ResumeId">دانلود فایل</a>
                <form asp-action="DeleteFile" asp-route-resumeId="@Model.ResumeId" method="post" style="display:inline;margin-right:8px;">
                    <button type="submit" class="btn">حذف فایل</button>
                </form>
            </div>
        }
        else
        {
            <div class="meta" style="margin-bottom: 12px;">فایلی آپلود نشده است.</div>
        }
        <form asp-action="UploadFile" asp-route-resumeId="@Model.ResumeId" method="post" enctype="multipart/form-data">
            <div class="form-group">
                <input type="file" name="File" class="form-control" />
            </div>
            <button type="submit" class="btn">آپلود فایل</button>
        </form>
    </div>

    <div style="margin-top: 14px;">
        <a class="btn" asp-controller="EducationDetail" asp-action="Index">مدیریت سوابق تحصیلی</a>
        <a class="btn" asp-controller="ExperienceDetail" asp-action="Index">مدیریت سوابق کاری</a>
        <a class="btn" asp-controller="Skill" asp-action="MySkills">مدیریت مهارت‌ها</a>
    </div>
}
