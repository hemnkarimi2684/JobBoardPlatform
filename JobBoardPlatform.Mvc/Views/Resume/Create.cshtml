@model ResumeCreateViewModel

@{
    ViewData["Title"] = "Create Resume";
}

<div class="card" style="max-width:520px; margin:0 auto;">
    <h3>Create Resume</h3>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        // Using the standard danger alert for errors.
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form asp-action="Create" method="post">
        @* ModelOnly displays all validation errors if the model state is invalid. *@
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="Title">Resume Title</label>
            <input asp-for="Title" class="form-control" placeholder="Enter resume title" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <button type="submit" class="btn">Create Resume</button>
    </form>
</div>
