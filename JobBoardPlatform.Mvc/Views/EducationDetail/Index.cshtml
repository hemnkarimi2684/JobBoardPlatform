@model EducationDetailIndexViewModel

@{
    ViewData["Title"] = "Education History";
}

<div style="direction: ltr; text-align: left;">
    <h2 style="margin-bottom: 18px; color: #1e3a5f;">Education History</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert" style="background:#fdecea; color:#b3392f; border:1px solid #f5c6c2;">@TempData["Error"]</div>
    }

    @if (Model.Data.Count == 0)
    {
        <div class="empty">No education records have been recorded yet.</div>
    }
    else
    {
        foreach (var item in Model.Data)
        {
            <div class="card">
                <h3>@item.Major</h3>
                <div class="meta" style="color: #666; margin-bottom: 15px;">
                    @item.University &nbsp;|&nbsp; @item.CertificateDegreeName
                </div>
                <div class="detail-grid">
                    <div><span>Start Date:</span> @item.StartDate.ToString("yyyy-MM-dd")</div>
                    <div><span>Completion Date:</span> @(item.CompletionDate?.ToString("yyyy-MM-dd") ?? "-")</div>
                    <div><span>GPA / Percentage:</span> @(item.Percentage?.ToString("N0") ?? "-")</div>
                    <div><span>Currently Studying:</span> @(item.IsCurrentlyStudying ? "Yes" : "No")</div>
                </div>
                <div style="margin-top: 12px;">
                    <a class="btn" asp-action="Edit" asp-route-id="@item.EducationDetailId">Edit</a>
                    <form asp-action="Delete" method="post" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this education record?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.EducationDetailId" />
                        <button type="submit" class="btn" style="background-color: #dc3545; color: white; border: none;">Delete</button>
                    </form>
                </div>
            </div>
        }

        <partial name="_Pager" model="@Model" />
    }

    <div style="margin-top: 14px;">
        <a class="btn" asp-action="Create">Add Education Record</a>
    </div>
</div>
