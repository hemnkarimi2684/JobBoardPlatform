@model EducationDetailCreateViewModel

@{
    ViewData["Title"] = "Add Education";
}

<div style="direction: ltr; text-align: left;">
    <div class="card" style="max-width:560px; margin:0 auto;">
        <h3>Add Education Record</h3>

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="CertificateDegree">Degree</label>
                <select asp-for="CertificateDegree" asp-items="ViewBag.CertificateDegrees" class="form-control">
                    <option value="">-- Select Degree --</option>
                </select>
                <span asp-validation-for="CertificateDegree" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Major">Major / Field of Study</label>
                <input asp-for="Major" class="form-control" placeholder="e.g., Computer Science" />
                <span asp-validation-for="Major" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="University">University / Institution</label>
                <input asp-for="University" class="form-control" placeholder="e.g., University of Technology" />
                <span asp-validation-for="University" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="StartDate">Start Date</label>
                <input asp-for="StartDate" class="form-control" type="date" />
                <span asp-validation-for="StartDate" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="CompletionDate">Completion Date</label>
                <input asp-for="CompletionDate" class="form-control" type="date" />
                <span asp-validation-for="CompletionDate" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Percentage">GPA / Percentage</label>
                <input asp-for="Percentage" class="form-control" placeholder="e.g., 18.5 or 90" />
                <span asp-validation-for="Percentage" class="text-danger"></span>
            </div>

            <div class="form-group" style="display: flex; align-items: center; gap: 8px;">
                <input asp-for="IsCurrentlyStudying" />
                <label asp-for="IsCurrentlyStudying" style="margin-bottom: 0;">Currently Studying</label>
            </div>

            <button type="submit" class="btn">Save Record</button>
        </form>
    </div>
</div>
