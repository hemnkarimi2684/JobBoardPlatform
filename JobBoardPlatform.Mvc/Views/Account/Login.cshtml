@model LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="card" style="max-width:420px; margin: 0 auto; direction: ltr; text-align: left;">
    <h3 style="margin-bottom: 20px;">Login to Account</h3>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <form asp-action="Login" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group" style="margin-bottom: 15px;">
            <label asp-for="EmailOrPhoneNumber">Email or Phone Number</label>
            <input asp-for="EmailOrPhoneNumber" class="form-control" placeholder="Enter email or phone" />
            <span asp-validation-for="EmailOrPhoneNumber" class="text-danger"></span>
        </div>

        <div class="form-group" style="margin-bottom: 15px;">
            <label asp-for="Password">Password</label>
            <input asp-for="Password" class="form-control" placeholder="Enter password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-group" style="margin-bottom: 15px;">
            <label asp-for="RememberMe" style="display: flex; align-items: center; gap: 8px;">
                <input asp-for="RememberMe" />
                Remember Me
            </label>
        </div>

        <button type="submit" class="btn" style="width: 100%;">Login</button>
    </form>

    <div style="margin-top: 20px; font-size: .9rem; border-top: 1px solid #eee; padding-top: 15px;">
        Don't have an account?
        <div style="margin-top: 5px;">
            <a asp-action="RegisterJobSeeker" class="text-primary">Register as Job Seeker</a>
            <span style="margin: 0 5px; color: #ccc;">|</span>
            <a asp-action="RegisterEmployer" class="text-primary">Register as Employer</a>
        </div>
    </div>
</div>
