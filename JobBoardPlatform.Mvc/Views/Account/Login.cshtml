@model LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="card auth-card">
    <h3>Login to Account</h3>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <form asp-action="Login" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="EmailOrPhoneNumber">Email or Phone Number</label>
            <input asp-for="EmailOrPhoneNumber" class="form-control" placeholder="Enter email or phone" />
            <span asp-validation-for="EmailOrPhoneNumber" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Password">Password</label>
            <input asp-for="Password" class="form-control" placeholder="Enter password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="RememberMe" class="form-check" style="font-weight: 500;">
                <input asp-for="RememberMe" />
                <span>Remember Me</span>
            </label>
        </div>

        <button type="submit" class="btn btn-primary btn-block">Login</button>
    </form>

    <div class="auth-footer">
        Don't have an account?
        <div style="margin-top: 5px;">
            <a asp-action="RegisterJobSeeker">Register as Job Seeker</a>
            <span style="margin: 0 5px; color: var(--border);">|</span>
            <a asp-action="RegisterEmployer">Register as Employer</a>
        </div>
    </div>
</div>
