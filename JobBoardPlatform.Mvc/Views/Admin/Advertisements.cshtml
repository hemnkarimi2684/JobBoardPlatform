@model AdvertisementsViewModel

@{
    ViewData["Title"] = "Manage Advertisements";
}

<div class="page-head">
    <div>
        <h1 class="page-title">Manage Advertisements</h1>
        <p class="subtitle">Activate, feature, or remove job advertisements.</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (Model.Data.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon">&#128196;</div>
        <h3>No advertisements found</h3>
        <p>No advertisements found.</p>
    </div>
}
else
{
    <div class="job-list">
        @foreach (var item in Model.Data)
        {
            <div class="card">
                <h3 style="margin-bottom: 0;">@item.JobName</h3>

                <div class="meta" style="margin-top: 6px;">
                    @item.CompanyName
                    &nbsp;|&nbsp;
                    @item.CityName
                    &nbsp;|&nbsp;
                    @item.CreatedAt.ToString("yyyy/MM/dd")
                </div>

                <div style="margin: 12px 0;">
                    @if (item.IsActive)
                    {
                        <span class="badge badge-success">Active</span>
                    }
                    else
                    {
                        <span class="badge badge-danger">Inactive</span>
                    }

                    @if (item.IsFeatured)
                    {
                        <span class="badge badge-warning">Featured</span>
                    }
                </div>

                <div style="display: flex; flex-wrap: wrap; gap: 8px; align-items: center;">
                    @if (item.IsActive)
                    {
                        <form asp-action="DeactivateAdvertisement"
                              asp-route-advertisementId="@item.AdvertisementId"
                              method="post"
                              style="display:inline;">
                            @Html.AntiForgeryToken()

                            <button type="submit" class="btn btn-warning">Deactivate</button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="ActivateAdvertisement"
                              asp-route-advertisementId="@item.AdvertisementId"
                              method="post"
                              style="display:inline;">
                            @Html.AntiForgeryToken()

                            <button type="submit" class="btn btn-success">Activate</button>
                        </form>
                    }

                    <form asp-action="DeleteAdvertisement"
                          asp-route-advertisementId="@item.AdvertisementId"
                          method="post"
                          style="display:inline;"
                          onsubmit="return confirm('Are you sure you want to delete this advertisement?');">
                        @Html.AntiForgeryToken()

                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>

                    @if (item.IsFeatured)
                    {
                        <form asp-action="DemoteAdvertisement"
                              asp-route-advertisementId="@item.AdvertisementId"
                              method="post"
                              style="display:inline;"
                              onsubmit="return confirm('Are you sure you want to remove this advertisement from featured listings?');">
                            @Html.AntiForgeryToken()

                            <button type="submit" class="btn btn-secondary">Remove Featured</button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="PromoteAdvertisement"
                              asp-route-advertisementId="@item.AdvertisementId"
                              method="post"
                              style="display:inline-flex;
                            align-items:center;
                            gap:8px;">
                            @Html.AntiForgeryToken()

                            <input type="number"
                                   name="durationInDays"
                                   min="1"
                                   value="7"
                                   class="form-control"
                                   style="width:100px;"
                                   aria-label="Featured duration in days"
                                   placeholder="Days" />

                            <button type="submit" class="btn btn-primary">Make Featured</button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>

    <partial name="_Pager" model="Model" />
}
