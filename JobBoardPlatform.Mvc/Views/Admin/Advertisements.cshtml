@model Pagination<AdvertisementDetailResponseDto>

@{
    ViewData["Title"] = "آگهی‌ها";
}

<h2 style="margin-bottom: 18px; color: #1e3a5f;">مدیریت آگهی‌ها</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert text-danger">@TempData["Error"]</div>
}

@if (Model.Data.Count == 0)
{
    <div class="empty">آگهی‌ای ثبت نشده است.</div>
}
else
{
    foreach (var item in Model.Data)
    {
        <div class="card">
            <h3>@item.JobName</h3>
            <div class="meta">@item.CompanyName &nbsp;|&nbsp; @item.CityName &nbsp;|&nbsp; @item.CreatedAt.ToString("yyyy/MM/dd")</div>
            <div>
                @if (item.IsActive)
                {
                    <span class="badge">فعال</span>
                }
                else
                {
                    <span class="badge" style="background:#fdecea;color:#d64545;">غیرفعال</span>
                }
                @if (item.IsFeatured)
                {
                    <span class="badge">ویژه</span>
                }
            </div>
            <div style="margin-top:12px;display:flex;flex-wrap:wrap;gap:10px;align-items:center;">
                @if (item.IsActive)
                {
                    <form asp-action="DeactivateAdvertisement" asp-route-advertisementId="@item.AdvertisementId" method="post" style="display:inline;">
                        <button type="submit" class="btn" style="background:#e8a100;">غیرفعال‌سازی</button>
                    </form>
                }
                else
                {
                    <form asp-action="ActivateAdvertisement" asp-route-advertisementId="@item.AdvertisementId" method="post" style="display:inline;">
                        <button type="submit" class="btn">فعال‌سازی</button>
                    </form>
                }
                <form asp-action="DeleteAdvertisement" asp-route-advertisementId="@item.AdvertisementId" method="post" style="display:inline;">
                    <button type="submit" class="btn" style="background:#d64545;">حذف</button>
                </form>
                <form asp-action="PromoteAdvertisement" asp-route-advertisementId="@item.AdvertisementId" method="post" style="display:inline-flex;align-items:center;gap:8px;">
                    <input type="number" name="durationInDays" min="1" value="7" class="form-control" style="width:130px;" placeholder="مدت (روز)" />
                    <button type="submit" class="btn" style="background:#7b3fe4;">ویژه کردن</button>
                </form>
            </div>
        </div>
    }

    <partial name="_Pager" model="Model" />
}
