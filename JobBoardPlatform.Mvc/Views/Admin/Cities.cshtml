@model CitiesViewModel

@{
    ViewData["Title"] = "Cities";
}

<div class="page-head">
    <div>
        <h1 class="page-title">Manage Cities</h1>
        <p class="subtitle">Add and manage cities on the platform.</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="panel">
    <h3 class="section-title">Add New City</h3>

    <form asp-action="CreateCity" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" name="pageNumber" value="@Model.PageNumber" />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label>City Name</label>
            <input type="text" name="Name" class="form-control" placeholder="Enter city name" />
        </div>

        <div class="form-group">
            <label>City Code</label>
            <input type="number" name="Code" class="form-control" placeholder="Enter city code" />
        </div>

        <div class="form-group">
            <label>Province</label>
            <select name="ProvinceId" class="form-control" asp-items="ViewBag.Provinces">
                <option value="">-- Select Province --</option>
            </select>
        </div>

        <button type="submit" class="btn btn-primary">Add City</button>
    </form>
</div>

<h3 class="section-title">City List</h3>

@if (Model.Cities == null || Model.Cities.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon">&#127970;</div>
        <h3>No cities yet</h3>
        <p>No cities registered yet.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>City Name</th>
                    <th>City Code</th>
                    <th>Province</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Cities)
                {
                    <tr>
                        <td>@item.CityName</td>
                        <td>@item.CityCode</td>
                        <td>@item.ProvinceName</td>
                        <td>
                            <form asp-action="DeleteCity" method="post" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this city?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="cityId" value="@item.CityId" />
                                <input type="hidden" name="pageNumber" value="@Model.PageNumber" />
                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Model.TotalPageCount > 1)
{
    <nav class="pager">
        @if (Model.PageNumber > 1)
        {
            <a class="pager-link" asp-action="Cities" asp-route-pageNumber="@(Model.PageNumber - 1)">&#8592; Previous</a>
        }

        <span class="pager-current">Page @Model.PageNumber of @Model.TotalPageCount</span>

        @if (Model.PageNumber < Model.TotalPageCount)
        {
            <a class="pager-link" asp-action="Cities" asp-route-pageNumber="@(Model.PageNumber + 1)">Next &#8594;</a>
        }
    </nav>
}
