        </div>
        <div>
            <div class="stat-value">@Model.JobSeekersCount</div>
            <div class="stat-label">Job Seekers</div>
        </div>
    </a>

    <a class="card stat-card" asp-action="Advertisements">
        <div class="stat-icon red">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 0 0 .75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 0 0-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0 1 12 15c-2.743 0-5.357-.467-7.827-1.47-.254-.085-.48-.215-.673-.38m0 0A2.18 2.18 0 0 1 3 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 0 1 3.413-.387m16.5 0V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 0 0-3.413-.387m-7.5 0a48.114 48.114 0 0 1 3.413-.387m-7.5 0c.106.97.505 1.85 1.162 2.554m-1.162-2.554a11.986 11.986 0 0 0-4.252.06M18 4.5A3 3 0 0 1 21 7.5m-3-3A3 3 0 0 0 15 7.5m3-3A3 3 0 0 1 18 7.5" /></svg>
        </div>
        <div>
            <div class="stat-value">@Model.ActiveAdvertisementsCount</div>
            <div class="stat-label">Active Ads</div>
            <div class="stat-sub">
                <span class="badge badge-danger">Inactive: @Model.InactiveAdvertisementsCount</span>
            </div>
        </div>
    </a>
</div>

<div class="dashboard-section-title">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" /></svg>
    Platform Analytics
</div>

<div class="chart-grid">
    <section class="panel chart-card">
        <div class="panel-head">
            <h3>
                <span class="chart-title-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
                </span>
                Job Applications by Status
            </h3>
        </div>
        @if (!hasStatusData)
        {
            <p class="meta">No job applications registered yet.</p>
        }
        else
        {
            <div class="donut-wrap">
                <div class="donut-chart" style="background: conic-gradient(@donutBackground);">
                    <div class="donut-center">
                        <span class="donut-total">@totalApplications</span>
                        <span class="donut-caption">Applications</span>
                    </div>
                </div>
                <div class="donut-legend">
                    @foreach (var item in statusCounts)
                    {
                        <div class="legend-row">
                            <span class="legend-dot" style="background: @StatusColor(item.StatusName);"></span>
                            <span class="legend-name">@StatusLabel(item.StatusName)</span>
                            <span class="legend-value">@item.CountPerStatus</span>
                        </div>
                    }
                </div>
            </div>
        }
    </section>

    <section class="panel chart-card">
        <div class="panel-head">
            <h3>
                <span class="chart-title-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" /></svg>
                </span>
                Users Breakdown
            </h3>
        </div>
        <div class="bars">
            <div class="bar-row">
                <div class="bar-head">
                    <span class="bar-name">Job Seekers</span>
                    <span class="bar-pct">@((int)Math.Round((double)Model.JobSeekersCount / userTotal * 100))%</span>
                </div>
                <div class="bar-track">
                    <div class="bar-fill green" style="width: @((double)Model.JobSeekersCount / userTotal * 100)%"></div>
                </div>
            </div>
            <div class="bar-row">
                <div class="bar-head">
                    <span class="bar-name">Employers</span>
                    <span class="bar-pct">@((int)Math.Round((double)Model.EmployersCount / userTotal * 100))%</span>
                </div>
                <div class="bar-track">
                    <div class="bar-fill" style="width: @((double)Model.EmployersCount / userTotal * 100)%"></div>
                </div>
            </div>
            <div class="bar-row">
                <div class="bar-head">
                    <span class="bar-name">Pending Approval</span>
                    <span class="bar-pct">@((int)Math.Round((double)Model.PendingEmployersCount / userTotal * 100))%</span>
                </div>
                <div class="bar-track">
                    <div class="bar-fill amber" style="width: @((double)Model.PendingEmployersCount / userTotal * 100)%"></div>
                </div>
            </div>
        </div>
    </section>

    <section class="panel chart-card">
        <div class="panel-head">
            <h3>
                <span class="chart-title-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25m18 0A2.25 2.25 0 0 0 18.75 3H5.25A2.25 2.25 0 0 0 3 5.25m18 0V12a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 12V5.25" /></svg>
                </span>
                Advertisements
            </h3>
        </div>
        <div class="bars">
            <div class="bar-row">
                <div class="bar-head">
                    <span class="bar-name">Active Ads</span>
                    <span class="bar-pct">@((int)Math.Round((double)Model.ActiveAdvertisementsCount / adsTotal * 100))%</span>
                </div>
                <div class="bar-track">
                    <div class="bar-fill green" style="width: @((double)Model.ActiveAdvertisementsCount / adsTotal * 100)%"></div>
                </div>
            </div>
            <div class="bar-row">
                <div class="bar-head">
                    <span class="bar-name">Inactive Ads</span>
                    <span class="bar-pct">@((int)Math.Round((double)Model.InactiveAdvertisementsCount / adsTotal * 100))%</span>
                </div>
                <div class="bar-track">
                    <div class="bar-fill red" style="width: @((double)Model.InactiveAdvertisementsCount / adsTotal * 100)%"></div>
                </div>
            </div>
        </div>
    </section>
</div>

<div class="dashboard-section-title">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-9.75 0h9.75" /></svg>
