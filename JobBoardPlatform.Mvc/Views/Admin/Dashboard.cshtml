@model DashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";

    var statusCounts = Model.JobApplicationStatusCounts ?? new List<JobApplicationStatusCount>();
    var totalApplications = statusCounts.Sum(s => s.CountPerStatus);
    var hasStatusData = totalApplications > 0;

    var userTotal = Model.JobSeekersCount + Model.EmployersCount + Model.PendingEmployersCount;
    userTotal = userTotal == 0 ? 1 : userTotal;
    var adsTotal = Model.ActiveAdvertisementsCount + Model.InactiveAdvertisementsCount;
    adsTotal = adsTotal == 0 ? 1 : adsTotal;

    string StatusColor(JobApplicationStatus status) => status switch
    {
        JobApplicationStatus.Pending => "#f59e0b",
        JobApplicationStatus.Reviewing => "#0ea5e9",
        JobApplicationStatus.Interview => "#8b5cf6",
        JobApplicationStatus.Accepted => "#16a34a",
        JobApplicationStatus.Rejected => "#ef4444",
        JobApplicationStatus.Cancelled => "#94a3b8",
        _ => "#94a3b8"
    };

    string StatusLabel(JobApplicationStatus status) => status switch
    {
        JobApplicationStatus.Pending => "Pending",
        JobApplicationStatus.Reviewing => "Reviewing",
        JobApplicationStatus.Interview => "Interview",
        JobApplicationStatus.Accepted => "Accepted",
        JobApplicationStatus.Rejected => "Rejected",
        JobApplicationStatus.Cancelled => "Cancelled",
        _ => status.ToString()
    };

    var stopAngle = 0.0;
    var gradientParts = new List<string>();
    foreach (var item in statusCounts)
    {
        if (item.CountPerStatus <= 0) continue;
        var start = stopAngle;
        stopAngle += (double)item.CountPerStatus / totalApplications * 360;
        gradientParts.Add($"{StatusColor(item.StatusName)} {start:F1}deg {stopAngle:F1}deg");
    }
    var donutBackground = gradientParts.Count == 0
        ? "var(--border)"
        : string.Join(", ", gradientParts);
}

<div class="page-head">
    <div>
        <h1 class="page-title">Admin Dashboard</h1>
        <p class="subtitle">Overview of your job board platform.</p>
    </div>
    <div class="section-head-actions">
        <a class="btn btn-outline btn-sm" asp-controller="Admin" asp-action="Employers">Review Employers</a>
        <a class="btn btn-primary btn-sm" asp-controller="Advertisement" asp-action="Index">View Site</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

