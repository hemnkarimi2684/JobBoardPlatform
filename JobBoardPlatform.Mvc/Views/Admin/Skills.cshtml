@model SkillsViewModel

@{
    ViewData["Title"] = "Skills";
}

<div class="page-head">
    <div>
        <h1 class="page-title">Manage Skills</h1>
        <p class="subtitle">Add and manage skills on the platform.</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="panel">
    <h3 class="section-title">Add New Skill</h3>

    <form asp-action="CreateSkill" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" name="pageNumber" value="@Model.PageNumber" />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label for="Name">Skill Name</label>
            <input type="text"
                   id="Name"
                   name="Name"
                   class="form-control"
                   placeholder="e.g. ASP.NET Core"
                   required />
        </div>

        <button type="submit" class="btn btn-primary">Add Skill</button>
    </form>
</div>

@if (Model.Data == null || Model.Data.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon">&#128269;</div>
        <h3>No skills yet</h3>
        <p>No skills registered.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Skill Name</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Data)
                {
                    <tr>
                        <td>@item.SkillName</td>
                        <td>
                            <form asp-action="DeleteSkill" method="post" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this skill?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="skillId" value="@item.SkillId" />
                                <input type="hidden" name="pageNumber" value="@Model.PageNumber" />
                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPageCount > 1)
    {
        <nav class="pager">
            @if (Model.PageNumber > 1)
            {
                <a class="pager-link" asp-action="Skills" asp-route-pageNumber="@(Model.PageNumber - 1)">&#8592; Previous</a>
            }

            <span class="pager-current">Page @Model.PageNumber of @Model.TotalPageCount</span>

            @if (Model.PageNumber < Model.TotalPageCount)
            {
                <a class="pager-link" asp-action="Skills" asp-route-pageNumber="@(Model.PageNumber + 1)">Next &#8594;</a>
            }
        </nav>
    }
}
