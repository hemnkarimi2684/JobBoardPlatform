@model Pagination<EmailTemplateResponseDto>

@{
    ViewData["Title"] = "Email Templates";
}

<div style="direction: ltr; text-align: left;">
    <h2 style="margin-bottom: 18px; color: #1e3a5f;">Manage Email Templates</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert text-danger">@TempData["Error"]</div>
    }

    @if (Model.Data.Count == 0)
    {
        <div class="empty">No email templates registered.</div>
    }
    else
    {
        foreach (var item in Model.Data)
        {
            <div class="card" style="margin-bottom: 20px;">
                <h3 style="margin-top: 0;">@item.Key</h3>
                <div class="meta" style="color: #666; margin-bottom: 10px;">@item.Subject</div>
                <div style="margin-bottom: 15px;">
                    @if (item.IsActive)
                    {
                        <span class="badge" style="background: #e2f0d9; color: #385723; padding: 4px 8px; border-radius: 4px;">Active</span>
                    }
                    else
                    {
                        <span class="badge" style="background: #fdecea; color: #d64545; padding: 4px 8px; border-radius: 4px;">Inactive</span>
                    }
                </div>

                <form asp-action="UpdateTemplate" asp-route-id="@item.Id" method="post" style="margin-top:12px;">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-group" style="margin-bottom: 10px;">
                        <label>Subject</label>
                        <input type="text" name="Subject" value="@item.Subject" class="form-control" />
                    </div>

                    <div class="form-group" style="margin-bottom: 10px;">
                        <label>Template Body</label>
                        <textarea name="Body" class="form-control" rows="6">@item.Body</textarea>
                    </div>

                    <button type="submit" class="btn">Save Changes</button>
                </form>

                <div style="margin-top:15px; border-top: 1px solid #eee; padding-top: 10px;">
                    @if (item.IsActive)
                    {
                        <form asp-action="DeactivateTemplate" asp-route-id="@item.Id" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn" style="background:#e8a100;">Deactivate</button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="ActivateTemplate" asp-route-id="@item.Id" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn">Activate</button>
                        </form>
                    }
                </div>
            </div>
        }

        <partial name="_Pager" model="Model" />
    }
</div>

