@model EmailTemplatesViewModel

@{
    ViewData["Title"] = "Email Templates";
}

<div class="page-head">
    <div>
        <h1 class="page-title">Manage Email Templates</h1>
        <p class="subtitle">Edit the subject and body of notification email templates.</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (Model.Data == null || Model.Data.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon">&#128231;</div>
        <h3>No email templates registered</h3>
        <p>No email templates registered.</p>
    </div>
}
else
{
    <div class="job-list">
        @foreach (var item in Model.Data)
        {
            <div class="card">
                <h3 style="margin-bottom: 0;">@item.Key</h3>
                <div class="meta" style="margin-top: 4px;">@item.Subject</div>

                <div style="margin: 12px 0;">
                    @if (item.IsActive)
                    {
                        <span class="badge badge-success">Active</span>
                    }
                    else
                    {
                        <span class="badge badge-danger">Inactive</span>
                    }
                </div>

                <form asp-action="UpdateTemplate" asp-route-id="@item.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="pageNumber" value="@Model.PageNumber" />

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-group">
                        <label>Subject</label>
                        <input type="text" name="Subject" value="@item.Subject" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Template Body</label>
                        <textarea name="Body" class="form-control" rows="6">@item.Body</textarea>
                    </div>

                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </form>

                <div style="margin-top: 16px; border-top: 1px solid var(--border); padding-top: 12px;">
                    @if (item.IsActive)
                    {
                        <form asp-action="DeactivateTemplate" asp-route-id="@item.Id" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="pageNumber" value="@Model.PageNumber" />
                            <button type="submit" class="btn btn-warning">Deactivate</button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="ActivateTemplate" asp-route-id="@item.Id" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="pageNumber" value="@Model.PageNumber" />
                            <button type="submit" class="btn btn-success">Activate</button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>

    @if (Model.TotalPageCount > 1)
    {
        <nav class="pager" style="margin: 24px 0;">
            @if (Model.PageNumber > 1)
            {
                <a class="pager-link" asp-action="EmailTemplates"
                   asp-route-pageNumber="@(Model.PageNumber - 1)">&#8592; Previous</a>
            }

            <span class="pager-current">Page @Model.PageNumber of @Model.TotalPageCount</span>

            @if (Model.PageNumber < Model.TotalPageCount)
            {
                <a class="pager-link" asp-action="EmailTemplates"
                   asp-route-pageNumber="@(Model.PageNumber + 1)">Next &#8594;</a>
            }
        </nav>
    }
}
