@model Pagination<EmailTemplateResponseDto>

@{
    ViewData["Title"] = "قالب‌های ایمیل";
}

<h2 style="margin-bottom: 18px; color: #1e3a5f;">مدیریت قالب‌های ایمیل</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert text-danger">@TempData["Error"]</div>
}

@if (Model.Data.Count == 0)
{
    <div class="empty">قالب ایمیلی ثبت نشده است.</div>
}
else
{
    foreach (var item in Model.Data)
    {
        <div class="card">
            <h3>@item.Key</h3>
            <div class="meta">@item.Subject</div>
            <div>
                @if (item.IsActive)
                {
                    <span class="badge">فعال</span>
                }
                else
                {
                    <span class="badge" style="background:#fdecea;color:#d64545;">غیرفعال</span>
                }
            </div>

            <form asp-action="UpdateTemplate" asp-route-id="@item.Id" method="post" style="margin-top:12px;">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">
                    <label>موضوع</label>
                    <input type="text" name="Subject" value="@item.Subject" class="form-control" />
                </div>

                <div class="form-group">
                    <label>متن قالب</label>
                    <textarea name="Body" class="form-control" rows="6">@item.Body</textarea>
                </div>

                <button type="submit" class="btn">ذخیره تغییرات</button>
            </form>

            <div style="margin-top:10px;">
                @if (item.IsActive)
                {
                    <form asp-action="DeactivateTemplate" asp-route-id="@item.Id" method="post" style="display:inline;">
                        <button type="submit" class="btn" style="background:#e8a100;">غیرفعال‌سازی</button>
                    </form>
                }
                else
                {
                    <form asp-action="ActivateTemplate" asp-route-id="@item.Id" method="post" style="display:inline;">
                        <button type="submit" class="btn">فعال‌سازی</button>
                    </form>
                }
            </div>
        </div>
    }

    <partial name="_Pager" model="Model" />
}
