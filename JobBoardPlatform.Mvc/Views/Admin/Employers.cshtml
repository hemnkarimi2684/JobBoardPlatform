@{
    ViewData["Title"] = "کارفرمایان";
}

<h2 style="margin-bottom: 18px; color: #1e3a5f;">مدیریت کارفرمایان</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert text-danger">@TempData["Error"]</div>
}

<h3 style="margin: 18px 0 10px; color: #1e3a5f;">کارفرمایان تأیید نشده</h3>
@{
    var unapproved = (List<EmployerDetailResponseDto>)ViewBag.UnapprovedEmployers;
}
@if (unapproved.Count == 0)
{
    <div class="empty">کارفرمایی در انتظار تأیید وجود ندارد.</div>
}
else
{
    foreach (var item in unapproved)
    {
        <div class="card">
            <h3>@item.Email</h3>
            <div class="meta">تلفن: @item.PhoneNumber</div>
            <div style="margin-top:10px;">
                <form asp-action="ApproveEmployer" asp-route-userId="@item.EmployerId" method="post" style="display:inline;">
                    <button type="submit" class="btn">تأیید</button>
                </form>
                <form asp-action="RejectEmployer" asp-route-userId="@item.EmployerId" method="post" style="display:inline;">
                    <button type="submit" class="btn" style="background:#d64545;">رد</button>
                </form>
            </div>
        </div>
    }
}

<h3 style="margin: 18px 0 10px; color: #1e3a5f;">کارفرمایان تأیید شده</h3>
@{
    var approved = (List<EmployerDetailResponseDto>)ViewBag.ApprovedEmployers;
}
@if (approved.Count == 0)
{
    <div class="empty">کارفرمایی تأیید شده وجود ندارد.</div>
}
else
{
    foreach (var item in approved)
    {
        <div class="card">
            <h3>@item.CompanyName</h3>
            <div class="meta">@item.Email &nbsp;|&nbsp; تلفن: @item.PhoneNumber</div>
        </div>
    }
}
