@model EmployersViewModel

@{
    ViewData["Title"] = "Employers";
}

<div class="detail-hero">
    <div class="detail-hero-main">
        <div class="detail-hero-icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21" /></svg>
        </div>
        <div>
            <h1 class="detail-hero-title">Manage Employers</h1>
            <div class="detail-hero-meta">
                <span>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m-6-8h6m-9 12h12a2.25 2.25 0 0 0 2.25-2.25V6A2.25 2.25 0 0 0 18 3.75H6A2.25 2.25 0 0 0 3.75 6v12A2.25 2.25 0 0 0 6 21Z" /></svg>
                    Approve, reject, and review employer accounts.
                </span>
            </div>
        </div>
    </div>
</div>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="job-badges" style="margin-bottom: 10px;">
    <span class="badge badge-warning">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" width="14" height="14"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
        @Model.UnapprovedEmployers.Count Pending
    </span>
    <span class="badge badge-success">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" width="14" height="14"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
        @Model.ApprovedEmployers.Count Approved
    </span>
</div>

<!-- Pending Employers -->
<div class="section-head">
    <div class="section-head-copy">
        <h2>
            <span class="section-icon">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
            </span>
            Pending Employers
        </h2>
        <p>Accounts waiting for your review.</p>
    </div>
</div>

@{
    var unapproved = Model.UnapprovedEmployers;
}

@if (unapproved == null || unapproved.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon">&#10003;</div>
        <h3>No pending employers</h3>
        <p>No pending employers found.</p>
    </div>
}
else
{
    <div class="job-list">
        @foreach (var item in unapproved)
        {
            <div class="card">
                <div class="card-between">
                    <div style="min-width: 0;">
                        <h3 style="margin-bottom: 0;">@item.Email</h3>
                        <div class="meta" style="margin-top: 6px;">
                            <strong>Company:</strong> @(string.IsNullOrEmpty(item.CompanyName) ? "Not Created Yet" : item.CompanyName)
                            &nbsp;|&nbsp;
                            <strong>Phone:</strong> @(string.IsNullOrEmpty(item.PhoneNumber) ? "N/A" : item.PhoneNumber)
                        </div>
                    </div>
                    <span class="badge badge-warning">Pending</span>
                </div>

                <div style="margin-top: 14px; display: flex; gap: 8px; flex-wrap: wrap;">
                    <form asp-action="ApproveEmployer" asp-route-userId="@item.EmployerId" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to approve this employer?');">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="approvedPage" value="@Model.ApprovedCurrentPage" />
                        <input type="hidden" name="unapprovedPage" value="@Model.UnapprovedCurrentPage" />

                        <button type="submit" class="btn btn-success">Approve</button>
                    </form>

                    <form asp-action="RejectEmployer" asp-route-userId="@item.EmployerId" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to reject this employer?');">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="approvedPage" value="@Model.ApprovedCurrentPage" />
                        <input type="hidden" name="unapprovedPage" value="@Model.UnapprovedCurrentPage" />

                        <button type="submit" class="btn btn-danger">Reject</button>
                    </form>
                </div>
            </div>
        }
    </div>

    @if (Model.UnapprovedTotalPages > 1)
    {
        <nav class="pager" style="margin: 24px 0;">
            @if (Model.UnapprovedCurrentPage > 1)
            {
                <a class="pager-link" asp-action="Employers"
                   asp-route-approvedPage="@Model.ApprovedCurrentPage"
                   asp-route-unapprovedPage="@(Model.UnapprovedCurrentPage - 1)">&#8592; Previous</a>
            }

            <span class="pager-current">Page @Model.UnapprovedCurrentPage of @Model.UnapprovedTotalPages</span>

            @if (Model.UnapprovedCurrentPage < Model.UnapprovedTotalPages)
            {
                <a class="pager-link" asp-action="Employers"
                   asp-route-approvedPage="@Model.ApprovedCurrentPage"
                   asp-route-unapprovedPage="@(Model.UnapprovedCurrentPage + 1)">Next &#8594;</a>
            }
        </nav>
    }
}

<!-- Approved Employers -->
<div class="section-head" style="margin-top: 36px;">
    <div class="section-head-copy">
        <h2>
            <span class="section-icon">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
            </span>
            Approved Employers
        </h2>
        <p>Employers approved to post on the platform.</p>
    </div>
</div>

@{
    var approved = Model.ApprovedEmployers;
}

@if (approved == null || approved.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon">&#128100;</div>
        <h3>No approved employers</h3>
        <p>No approved employers found.</p>
    </div>
}
else
{
    <div class="job-list">
        @foreach (var item in approved)
        {
            <div class="card card-hover">
                <div class="card-between">
                    <div style="min-width: 0;">
                        <h3 style="margin-bottom: 0;">@(string.IsNullOrEmpty(item.CompanyName) ? "No Company Name" : item.CompanyName)</h3>
                        <div class="meta" style="margin-top: 6px;">
                            <strong>Email:</strong> @item.Email &nbsp;|&nbsp;
                            <strong>Phone:</strong> @(string.IsNullOrEmpty(item.PhoneNumber) ? "N/A" : item.PhoneNumber)
                        </div>
                    </div>
                    <span class="badge badge-success">Approved</span>
                </div>
            </div>
        }
    </div>

    @if (Model.ApprovedTotalPages > 1)
    {
        <nav class="pager" style="margin: 24px 0;">
            @if (Model.ApprovedCurrentPage > 1)
            {
                <a class="pager-link" asp-action="Employers"
                   asp-route-approvedPage="@(Model.ApprovedCurrentPage - 1)"
                   asp-route-unapprovedPage="@Model.UnapprovedCurrentPage">&#8592; Previous</a>
            }

            <span class="pager-current">Page @Model.ApprovedCurrentPage of @Model.ApprovedTotalPages</span>

            @if (Model.ApprovedCurrentPage < Model.ApprovedTotalPages)
            {
                <a class="pager-link" asp-action="Employers"
                   asp-route-approvedPage="@(Model.ApprovedCurrentPage + 1)"
                   asp-route-unapprovedPage="@Model.UnapprovedCurrentPage">Next &#8594;</a>
            }
        </nav>
    }
}
