@model EmployersViewModel

@{
    ViewData["Title"] = "Employers";
}

<div class="page-head">
    <div>
        <h1 class="page-title">Manage Employers</h1>
        <p class="subtitle">Approve, reject, and review employer accounts.</p>
    </div>
</div>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<!-- Pending Employers -->
<h3 class="section-title">Pending Employers</h3>

@{
    var unapproved = Model.UnapprovedEmployers;
}

@if (unapproved == null || unapproved.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon">&#10003;</div>
        <h3>No pending employers</h3>
        <p>No pending employers found.</p>
    </div>
}
else
{
    <div class="job-list">
        @foreach (var item in unapproved)
        {
            <div class="card">
                <h3 style="margin-bottom: 0;">@item.Email</h3>
                <div class="meta" style="margin-top: 6px;">
                    <strong>Company:</strong> @(string.IsNullOrEmpty(item.CompanyName) ? "Not Created Yet" : item.CompanyName)
                    &nbsp;|&nbsp;
                    <strong>Phone:</strong> @(string.IsNullOrEmpty(item.PhoneNumber) ? "N/A" : item.PhoneNumber)
                </div>

                <div style="margin-top: 14px; display: flex; gap: 8px; flex-wrap: wrap;">
                    <form asp-action="ApproveEmployer" asp-route-userId="@item.EmployerId" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="approvedPage" value="@Model.ApprovedCurrentPage" />
                        <input type="hidden" name="unapprovedPage" value="@Model.UnapprovedCurrentPage" />

                        <button type="submit" class="btn btn-success">Approve</button>
                    </form>

                    <form asp-action="RejectEmployer" asp-route-userId="@item.EmployerId" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="approvedPage" value="@Model.ApprovedCurrentPage" />
                        <input type="hidden" name="unapprovedPage" value="@Model.UnapprovedCurrentPage" />

                        <button type="submit" class="btn btn-danger">Reject</button>
                    </form>
                </div>
            </div>
        }
    </div>

    @if (Model.UnapprovedTotalPages > 1)
    {
        <nav class="pager" style="margin: 24px 0;">
            @if (Model.UnapprovedCurrentPage > 1)
            {
                <a class="pager-link" asp-action="Employers"
                   asp-route-approvedPage="@Model.ApprovedCurrentPage"
                   asp-route-unapprovedPage="@(Model.UnapprovedCurrentPage - 1)">&#8592; Previous</a>
            }

            <span class="pager-current">Page @Model.UnapprovedCurrentPage of @Model.UnapprovedTotalPages</span>

            @if (Model.UnapprovedCurrentPage < Model.UnapprovedTotalPages)
            {
                <a class="pager-link" asp-action="Employers"
                   asp-route-approvedPage="@Model.ApprovedCurrentPage"
                   asp-route-unapprovedPage="@(Model.UnapprovedCurrentPage + 1)">Next &#8594;</a>
            }
        </nav>
    }
}

<!-- Approved Employers -->
<h3 class="section-title" style="margin-top: 28px;">Approved Employers</h3>

@{
    var approved = Model.ApprovedEmployers;
}

@if (approved == null || approved.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon">&#128100;</div>
        <h3>No approved employers</h3>
        <p>No approved employers found.</p>
    </div>
}
else
{
    <div class="job-list">
        @foreach (var item in approved)
        {
            <div class="card card-hover">
                <h3 style="margin-bottom: 0;">@(string.IsNullOrEmpty(item.CompanyName) ? "No Company Name" : item.CompanyName)</h3>
                <div class="meta" style="margin-top: 6px;">
                    <strong>Email:</strong> @item.Email &nbsp;|&nbsp;
                    <strong>Phone:</strong> @(string.IsNullOrEmpty(item.PhoneNumber) ? "N/A" : item.PhoneNumber)
                </div>
            </div>
        }
    </div>

    @if (Model.ApprovedTotalPages > 1)
    {
        <nav class="pager" style="margin: 24px 0;">
            @if (Model.ApprovedCurrentPage > 1)
            {
                <a class="pager-link" asp-action="Employers"
                   asp-route-approvedPage="@(Model.ApprovedCurrentPage - 1)"
                   asp-route-unapprovedPage="@Model.UnapprovedCurrentPage">&#8592; Previous</a>
            }

            <span class="pager-current">Page @Model.ApprovedCurrentPage of @Model.ApprovedTotalPages</span>

            @if (Model.ApprovedCurrentPage < Model.ApprovedTotalPages)
            {
                <a class="pager-link" asp-action="Employers"
                   asp-route-approvedPage="@(Model.ApprovedCurrentPage + 1)"
                   asp-route-unapprovedPage="@Model.UnapprovedCurrentPage">Next &#8594;</a>
            }
        </nav>
    }
}
