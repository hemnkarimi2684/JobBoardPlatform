@model JobSeekersViewModel

@{
    ViewData["Title"] = "Job Seekers";
}

<div class="page-head">
    <div>
        <h1 class="page-title">Manage Job Seekers</h1>
        <p class="subtitle">Activate or deactivate registered job seeker accounts.</p>
    </div>
</div>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (Model.Data == null || Model.Data.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon">&#128100;</div>
        <h3>No job seekers registered</h3>
        <p>No job seekers registered.</p>
    </div>
}
else
{
    <div class="job-list">
        @foreach (var item in Model.Data)
        {
            <div class="card">
                <h3 style="margin-bottom: 0;">@item.Email</h3>

                <div class="meta" style="margin-top: 6px;">
                    <strong>Phone:</strong> @(string.IsNullOrEmpty(item.PhoneNumber) ? "N/A" : item.PhoneNumber)
                    &nbsp;|&nbsp;
                    <strong>Registration Date:</strong> @item.CreatedAt.ToString("yyyy/MM/dd")
                </div>

                <div style="margin-top: 12px;">
                    @if (item.IsActive)
                    {
                        <span class="badge badge-success">Active</span>
                    }
                    else
                    {
                        <span class="badge badge-danger">Inactive</span>
                    }
                </div>

                <div style="margin-top: 14px; display: flex; gap: 8px; flex-wrap: wrap;">
                    @if (item.IsActive)
                    {
                        <form asp-action="DeactivateJobSeeker"
                              asp-route-userId="@item.Id"
                              method="post"
                              style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="pageNumber" value="@Model.PageNumber" />
                            <button type="submit" class="btn btn-danger">Deactivate</button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="ActivateJobSeeker"
                              asp-route-userId="@item.Id"
                              method="post"
                              style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="pageNumber" value="@Model.PageNumber" />
                            <button type="submit" class="btn btn-success">Activate</button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>

    @if (Model.TotalPageCount > 1)
    {
        <nav class="pager" style="margin: 24px 0;">
            @if (Model.PageNumber > 1)
            {
                <a class="pager-link" asp-action="JobSeekers"
                   asp-route-pageNumber="@(Model.PageNumber - 1)">&#8592; Previous</a>
            }

            <span class="pager-current">Page @Model.PageNumber of @Model.TotalPageCount</span>

            @if (Model.PageNumber < Model.TotalPageCount)
            {
                <a class="pager-link" asp-action="JobSeekers"
                   asp-route-pageNumber="@(Model.PageNumber + 1)">Next &#8594;</a>
            }
        </nav>
    }
}
