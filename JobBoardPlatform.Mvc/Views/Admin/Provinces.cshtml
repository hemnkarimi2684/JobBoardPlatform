@model ProvincesViewModel

@{
    ViewData["Title"] = "Provinces";
}

<div style="direction: ltr; text-align: left;">
    <h2 style="margin-bottom: 18px; color: #1e3a5f;">Manage Provinces</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert text-danger">@TempData["Error"]</div>
    }

    <div class="card" style="margin-bottom: 25px;">
        <h3 style="margin-top: 0;">Add New Province</h3>
        <form asp-action="CreateProvince" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="pageNumber" value="@Model.PageNumber" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group" style="margin-bottom: 15px;">
                <label style="display: block; margin-bottom: 5px;">Province Name</label>
                <input type="text" name="Name" class="form-control" placeholder="e.g. Ontario" />
            </div>

            <div class="form-group" style="margin-bottom: 15px;">
                <label style="display: block; margin-bottom: 5px;">Province Code</label>
                <input type="number" name="Code" class="form-control" placeholder="e.g. 101" />
            </div>

            <button type="submit" class="btn">Add Province</button>
        </form>
    </div>

    @if (Model.Data.Count == 0)
    {
        <div class="empty">No provinces registered.</div>
    }
    else
    {
        <table style="width:100%; border-collapse:collapse; margin-bottom: 20px;">
            <thead>
                <tr style="background:#e8f0fb;">
                    <th style="padding:10px; border:1px solid #cfd8e3; text-align:left;">Province Name</th>
                    <th style="padding:10px; border:1px solid #cfd8e3; text-align:left;">Province Code</th>
                    <th style="padding:10px; border:1px solid #cfd8e3; text-align:left;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Data)
                {
                    <tr>
                        <td style="padding:10px; border:1px solid #cfd8e3; text-align:left;">@item.Name</td>
                        <td style="padding:10px; border:1px solid #cfd8e3; text-align:left;">@item.Code</td>
                        <td style="padding:10px; border:1px solid #cfd8e3; text-align:left;">
                            <form asp-action="DeleteProvince" method="post" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this province?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="provinceId" value="@item.ProvinceId" />
                                <input type="hidden" name="pageNumber" value="@Model.PageNumber" />
                                <button type="submit" style="padding: 5px 10px; background-color: #dc3545; color: white; border: none; border-radius: 4px; cursor: pointer;">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Model.TotalPageCount > 1)
        {
            <div style="margin-top: 20px; display: flex; gap: 6px; flex-wrap: wrap; align-items: center;">
                @if (Model.PageNumber > 1)
                {
                    <a asp-action="Provinces"
                       asp-route-pageNumber="@(Model.PageNumber - 1)"
                       style="padding: 6px 12px; border: 1px solid #ccc; border-radius: 4px; text-decoration: none; color: #333;">
                        Previous
                    </a>
                }

                @for (var i = 1; i <= Model.TotalPageCount; i++)
                {
                    if (i == Model.PageNumber)
                    {
                        <span style="padding: 6px 12px; border: 1px solid #007bff; border-radius: 4px; background: #007bff; color: white;">
                            @i
                        </span>
                    }
                    else
                    {
                        <a asp-action="Provinces"
                           asp-route-pageNumber="@i"
                           style="padding: 6px 12px; border: 1px solid #ccc; border-radius: 4px; text-decoration: none; color: #333;">
                            @i
                        </a>
                    }
                }

                @if (Model.PageNumber < Model.TotalPageCount)
                {
                    <a asp-action="Provinces"
                       asp-route-pageNumber="@(Model.PageNumber + 1)"
                       style="padding: 6px 12px; border: 1px solid #ccc; border-radius: 4px; text-decoration: none; color: #333;">
                        Next
                    </a>
                }
            </div>
        }
    }
</div>
