@model Pagination<ProvinceResponseDto>

@{
    ViewData["Title"] = "استان‌ها";
}

<h2 style="margin-bottom: 18px; color: #1e3a5f;">مدیریت استان‌ها</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert text-danger">@TempData["Error"]</div>
}

<div class="card">
    <h3>افزودن استان جدید</h3>
    <form asp-action="CreateProvince" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label>نام استان</label>
            <input type="text" name="Name" class="form-control" placeholder="نام استان" />
        </div>

        <div class="form-group">
            <label>کد استان</label>
            <input type="number" name="Code" class="form-control" placeholder="کد استان" />
        </div>

        <button type="submit" class="btn">افزودن استان</button>
    </form>
</div>

@if (Model.Data.Count == 0)
{
    <div class="empty">استانی ثبت نشده است.</div>
}
else
{
    <table style="width:100%;border-collapse:collapse;">
        <thead>
            <tr style="background:#e8f0fb;">
                <th style="padding:10px;border:1px solid #cfd8e3;text-align:right;">نام استان</th>
                <th style="padding:10px;border:1px solid #cfd8e3;text-align:right;">کد استان</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Data)
            {
                <tr>
                    <td style="padding:10px;border:1px solid #cfd8e3;">@item.Name</td>
                    <td style="padding:10px;border:1px solid #cfd8e3;">@item.Code</td>
                </tr>
            }
        </tbody>
    </table>

    <partial name="_Pager" model="Model" />
}
