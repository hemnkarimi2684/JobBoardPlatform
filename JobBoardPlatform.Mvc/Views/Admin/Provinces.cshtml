@model ProvincesViewModel

@{
    ViewData["Title"] = "Provinces";
}

<div class="page-head">
    <div>
        <h1 class="page-title">Manage Provinces</h1>
        <p class="subtitle">Add and manage provinces on the platform.</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="panel">
    <h3 class="section-title">Add New Province</h3>
    <form asp-action="CreateProvince" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="pageNumber" value="@Model.PageNumber" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label>Province Name</label>
            <input type="text" name="Name" class="form-control" placeholder="e.g. Ontario" />
        </div>

        <div class="form-group">
            <label>Province Code</label>
            <input type="number" name="Code" class="form-control" placeholder="e.g. 101" />
        </div>

        <button type="submit" class="btn btn-primary">Add Province</button>
    </form>
</div>

@if (Model.Data.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon">&#127970;</div>
        <h3>No provinces yet</h3>
        <p>No provinces registered.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Province Name</th>
                    <th>Province Code</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Data)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.Code</td>
                        <td>
                            <form asp-action="DeleteProvince" method="post" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this province?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="provinceId" value="@item.ProvinceId" />
                                <input type="hidden" name="pageNumber" value="@Model.PageNumber" />
                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPageCount > 1)
    {
        <nav class="pager">
            @if (Model.PageNumber > 1)
            {
                <a class="pager-link" asp-action="Provinces" asp-route-pageNumber="@(Model.PageNumber - 1)">&#8592; Previous</a>
            }

            <span class="pager-current">Page @Model.PageNumber of @Model.TotalPageCount</span>

            @if (Model.PageNumber < Model.TotalPageCount)
            {
                <a class="pager-link" asp-action="Provinces" asp-route-pageNumber="@(Model.PageNumber + 1)">Next &#8594;</a>
            }
        </nav>
    }
}
