@{
    ViewData["Title"] = "شغل‌ها";
}

<h2 style="margin-bottom: 18px; color: #1e3a5f;">مدیریت شغل‌ها</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert text-danger">@TempData["Error"]</div>
}

<div class="card">
    <h3>افزودن شغل جدید</h3>
    <form asp-action="CreateJob" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label>نام شغل</label>
            <input type="text" name="Name" class="form-control" placeholder="نام شغل" />
        </div>

        <div class="form-group">
            <label>دسته‌بندی شغلی</label>
            <select name="JobCategoryId" class="form-control" asp-items="ViewBag.JobCategories">
                <option value="">انتخاب دسته‌بندی</option>
            </select>
        </div>

        <button type="submit" class="btn">افزودن شغل</button>
    </form>
</div>

<h3 style="margin: 18px 0 10px; color: #1e3a5f;">فهرست شغل‌ها</h3>
@{
    var jobs = (List<JobResponseDto>)ViewBag.Jobs;
}
@if (jobs.Count == 0)
{
    <div class="empty">شغلی ثبت نشده است.</div>
}
else
{
    <table style="width:100%;border-collapse:collapse;">
        <thead>
            <tr style="background:#e8f0fb;">
                <th style="padding:10px;border:1px solid #cfd8e3;text-align:right;">نام شغل</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in jobs)
            {
                <tr>
                    <td style="padding:10px;border:1px solid #cfd8e3;">@item.Name</td>
                </tr>
            }
        </tbody>
    </table>
}
