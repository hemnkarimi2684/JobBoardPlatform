@model JobsViewModel

@{
    ViewData["Title"] = "Jobs";
}

<div style="direction: ltr; text-align: left;">
    <h2 style="margin-bottom: 18px; color: #1e3a5f;">Manage Jobs</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card" style="margin-bottom: 25px;">
        <h3 style="margin-top: 0;">Add New Job</h3>
        <form asp-action="CreateJob" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="pageNumber" value="@Model.PageNumber" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group" style="margin-bottom: 15px;">
                <label style="display: block; margin-bottom: 5px;">Job Title</label>
                <input type="text" name="Name" class="form-control" placeholder="e.g. .NET Developer" />
            </div>

            <div class="form-group" style="margin-bottom: 15px;">
                <label style="display: block; margin-bottom: 5px;">Job Category</label>
                <select name="JobCategoryId" class="form-control" asp-items="ViewBag.JobCategories">
                    <option value="">Select Category</option>
                </select>
            </div>

            <button type="submit" class="btn">Add Job</button>
        </form>
    </div>

    <h3 style="margin: 18px 0 10px; color: #1e3a5f;">Job List</h3>

    @if (Model.Data == null || Model.Data.Count == 0)
    {
        <div class="empty">No jobs registered.</div>
    }
    else
    {
        <table style="width:100%; border-collapse:collapse; margin-bottom: 20px;">
            <thead>
                <tr style="background:#e8f0fb;">
                    <th style="padding:10px; border:1px solid #cfd8e3; text-align:left;">Job Title</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Data)
                {
                    <tr>
                        <td style="padding:10px; border:1px solid #cfd8e3; text-align:left;">@item.Name</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Model.TotalPageCount > 1)
        {
            <div style="margin-top: 20px; display: flex; gap: 6px; flex-wrap: wrap; align-items: center;">
                @if (Model.PageNumber > 1)
                {
                    <a asp-action="Jobs" asp-route-pageNumber="@(Model.PageNumber - 1)" style="padding: 6px 12px; border: 1px solid #ccc; border-radius: 4px; text-decoration: none; color: #333;">Previous</a>
                }

                @for (var i = 1; i <= Model.TotalPageCount; i++)
                {
                    if (i == Model.PageNumber)
                    {
                        <span style="padding: 6px 12px; border: 1px solid #007bff; border-radius: 4px; background: #007bff; color: white;">@i</span>
                    }
                    else
                    {
                        <a asp-action="Jobs" asp-route-pageNumber="@i" style="padding: 6px 12px; border: 1px solid #ccc; border-radius: 4px; text-decoration: none; color: #333;">@i</a>
                    }
                }

                @if (Model.PageNumber < Model.TotalPageCount)
                {
                    <a asp-action="Jobs" asp-route-pageNumber="@(Model.PageNumber + 1)" style="padding: 6px 12px; border: 1px solid #ccc; border-radius: 4px; text-decoration: none; color: #333;">Next</a>
                }
            </div>
        }
    }
</div>
