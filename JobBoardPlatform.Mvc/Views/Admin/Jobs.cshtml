@model JobsViewModel

@{
    ViewData["Title"] = "Jobs";
}

<div class="page-head">
    <div>
        <h1 class="page-title">Manage Jobs</h1>
        <p class="subtitle">Add and manage job titles on the platform.</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="panel">
    <h3 class="section-title">Add New Job</h3>
    <form asp-action="CreateJob" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="pageNumber" value="@Model.PageNumber" />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label>Job Title</label>
            <input type="text" name="Name" class="form-control" placeholder="e.g. .NET Developer" />
        </div>

        <div class="form-group">
            <label>Job Category</label>
            <select name="JobCategoryId" class="form-control" asp-items="ViewBag.JobCategories">
                <option value="">Select Category</option>
            </select>
        </div>

        <button type="submit" class="btn btn-primary">Add Job</button>
    </form>
</div>

<h3 class="section-title">Job List</h3>

@if (Model.Data == null || Model.Data.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon">&#128188;</div>
        <h3>No jobs yet</h3>
        <p>No jobs registered.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Job Title</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Data)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>
                            <form asp-action="DeleteJob" method="post" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this job?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="jobId" value="@item.JobId" />
                                <input type="hidden" name="pageNumber" value="@Model.PageNumber" />
                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPageCount > 1)
    {
        <nav class="pager">
            @if (Model.PageNumber > 1)
            {
                <a class="pager-link" asp-action="Jobs" asp-route-pageNumber="@(Model.PageNumber - 1)">&#8592; Previous</a>
            }

            <span class="pager-current">Page @Model.PageNumber of @Model.TotalPageCount</span>

            @if (Model.PageNumber < Model.TotalPageCount)
            {
                <a class="pager-link" asp-action="Jobs" asp-route-pageNumber="@(Model.PageNumber + 1)">Next &#8594;</a>
            }
        </nav>
    }
}
