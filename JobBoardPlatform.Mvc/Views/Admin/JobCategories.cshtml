@model JobCategoriesViewModel

@{
    ViewData["Title"] = "Job Categories";
}

<div style="direction: ltr; text-align: left;">
    <h2 style="margin-bottom: 18px; color: #1e3a5f;">Manage Job Categories</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card" style="margin-bottom: 25px;">
        <h3 style="margin-top: 0;">Add New Category</h3>

        <form asp-action="CreateJobCategory" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" name="pageNumber" value="@Model.PageNumber" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group" style="margin-bottom: 15px;">
                <label style="display: block; margin-bottom: 5px;">Category Name</label>
                <input type="text"
                       name="Name"
                       class="form-control"
                       placeholder="e.g. Software Development" />
            </div>

            <button type="submit" class="btn">Add Category</button>
        </form>
    </div>

    @if (Model.Data == null || Model.Data.Count == 0)
    {
        <div class="empty">No job categories registered.</div>
    }
    else
    {
        <table style="width:100%; border-collapse:collapse; margin-bottom: 20px;">
            <thead>
                <tr style="background:#e8f0fb;">
                    <th style="padding:10px; border:1px solid #cfd8e3; text-align:left;">Category Name</th>
                    <th style="padding:10px; border:1px solid #cfd8e3; text-align:left;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Data)
                {
                    <tr>
                        <td style="padding:10px; border:1px solid #cfd8e3; text-align:left;">
                            @item.Name
                        </td>
                        <td style="padding:10px; border:1px solid #cfd8e3; text-align:left;">
                            <form asp-action="DeleteJobCategory" method="post" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this job category?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="jobCategoryId" value="@item.JobCategoryId" />
                                <input type="hidden" name="pageNumber" value="@Model.PageNumber" />
                                <button type="submit" style="padding: 5px 10px; background-color: #dc3545; color: white; border: none; border-radius: 4px; cursor: pointer;">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Model.TotalPageCount > 1)
        {
            <div style="margin-top: 20px; display: flex; gap: 6px; flex-wrap: wrap; align-items: center;">
                @if (Model.PageNumber > 1)
                {
                    <a asp-action="JobCategories"
                       asp-route-pageNumber="@(Model.PageNumber - 1)"
                       style="padding: 6px 12px; border: 1px solid #ccc; border-radius: 4px; text-decoration: none; color: #333;">
                        Previous
                    </a>
                }

                @for (var i = 1; i <= Model.TotalPageCount; i++)
                {
                    if (i == Model.PageNumber)
                    {
                        <span style="padding: 6px 12px; border: 1px solid #007bff; border-radius: 4px; background: #007bff; color: white;">
                            @i
                        </span>
                    }
                    else
                    {
                        <a asp-action="JobCategories"
                           asp-route-pageNumber="@i"
                           style="padding: 6px 12px; border: 1px solid #ccc; border-radius: 4px; text-decoration: none; color: #333;">
                            @i
                        </a>
                    }
                }

                @if (Model.PageNumber < Model.TotalPageCount)
                {
                    <a asp-action="JobCategories"
                       asp-route-pageNumber="@(Model.PageNumber + 1)"
                       style="padding: 6px 12px; border: 1px solid #ccc; border-radius: 4px; text-decoration: none; color: #333;">
                        Next
                    </a>
                }
            </div>
        }
    }
</div>
