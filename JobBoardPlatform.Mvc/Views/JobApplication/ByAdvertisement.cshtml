@model Pagination<JobApplicationDetailResponseDto>

@{
    ViewData["Title"] = "Job Application Requests";
    // Get the list of statuses from the enum and prepare them for a dropdown.
    var statuses = Enum.GetValues<JobApplicationStatus>()
        .Select(e => new SelectListItem { Value = ((int)e).ToString(), Text = e.ToString() })
        .ToList();
    // Retrieve the AdvertisementId from ViewBag, which should be available in this context.
    var advertisementId = ViewBag.AdvertisementId;
}

<div style="direction: ltr; text-align: left;">
    <h2 style="margin-bottom: 18px; color: #1e3a5f;">Job Application Requests</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        // Using the standard danger alert for errors.
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (Model.Data.Count == 0)
    {
        <div class="empty">No applications have been submitted for this advertisement.</div>
    }
    else
    {
        foreach (var item in Model.Data)
        {
            <div class="card">
                <h3>@item.UserProfileName</h3>
                <div class="meta" style="color: #666; margin-bottom: 15px;">
                    @item.JobTitle &nbsp;|&nbsp; @item.CreatedAt.ToString("yyyy-MM-dd")
                </div>
                <div style="margin-bottom: 12px;">
                    <span class="badge">@item.Status</span>
                </div>
                <form asp-action="ChangeStatus" asp-route-id="@item.JobApplicationId" asp-route-advertisementId="@advertisementId" method="post" style="display:flex; gap:8px; align-items:center;">
                    @* Hidden input for advertisementId is redundant if passed via route, but kept for form structure consistency. *@
                    <input type="hidden" name="advertisementId" value="@advertisementId" />
                    <select name="status" class="form-control" style="width:auto;">
                        @foreach (var s in statuses)
                        {
                            <option value="@s.Value" selected="@(s.Value == ((int)item.Status).ToString() ? "selected" : null)">@s.Text</option>
                        }
                    </select>
                    <button type="submit" class="btn">Update Status</button>
                </form>
            </div>
        }

        <partial name="_Pager" model="@Model" />
    }
</div>
