@model JobApplicationByAdvertisementViewModel

@{
    ViewData["Title"] = "Job Application Requests";

    var statuses = Enum.GetValues<JobApplicationStatus>()
        .Select(status => new SelectListItem
        {
            Value = ((int)status).ToString(),
            Text = status.ToString()
        })
        .ToList();

    var advertisementId = Model.AdvertisementId;
}

<div class="page-head">
    <div>
        <h2>Job Application Requests</h2>
    </div>
    <a class="btn btn-ghost" asp-controller="Advertisement" asp-action="MyAds">&#8592; Back to My Ads</a>
</div>

@if (TempData["Success"] is not null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (Model.Data.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon">&#128203;</div>
        <h3>No applications yet</h3>
        <p>No applications have been submitted for this advertisement.</p>
    </div>
}
else
{
    <div style="display:flex; flex-direction:column; gap:16px;">
        @foreach (var item in Model.Data)
        {
            <div class="panel" style="margin-bottom:0;">
                <div class="application-card-top">
                    <div class="job-logo">
                        @(string.IsNullOrEmpty(item.UserProfileName) ? "?" : item.UserProfileName.Substring(0, 1))
                    </div>
                    <div class="job-heading">
                        <h3 style="font-size:1.05rem;">@item.UserProfileName</h3>
                        <div class="job-meta">
                            <span>&#128188; @item.JobTitle</span>
                            <span>&#128197; @item.CreatedAt.ToString("yyyy-MM-dd")</span>
                        </div>
                    </div>
                    <span class="badge badge-outline">@item.Status</span>
                </div>

                <div class="application-actions">
                    <form asp-action="ChangeStatus"
                          asp-route-id="@item.JobApplicationId"
                          asp-route-advertisementId="@advertisementId"
                          method="post"
                          class="application-form">
                        @Html.AntiForgeryToken()

                        <select name="status" class="form-control">
                            @foreach (var status in statuses)
                            {
                                <option value="@status.Value"
                                        selected="@(status.Value == ((int)item.Status).ToString())">
                                    @status.Text
                                </option>
                            }
                        </select>

                        <button type="submit" class="btn btn-ghost">Update Status</button>
                    </form>

                    <a asp-action="ApplicantResume"
                       asp-route-id="@item.JobApplicationId"
                       class="btn btn-outline">
                        View Applicant Resume
                    </a>
                </div>
            </div>
        }
    </div>

    <partial name="_Pager" model="@Model" />
}
