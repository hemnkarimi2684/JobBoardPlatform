@model Pagination<JobApplicationDetailResponseDto>

@{
    ViewData["Title"] = "Job Application Requests";

    var statuses = Enum.GetValues<JobApplicationStatus>()
        .Select(status => new SelectListItem
        {
            Value = ((int)status).ToString(),
            Text = status.ToString()
        })
        .ToList();

    var advertisementId = ViewBag.AdvertisementId;
}

<div style="direction: ltr; text-align: left;">
    <h2 style="margin-bottom: 18px; color: #1e3a5f;">
        Job Application Requests
    </h2>

    @if (TempData["Success"] is not null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] is not null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (Model.Data.Count == 0)
    {
        <div class="empty">
            No applications have been submitted for this advertisement.
        </div>
    }
    else
    {
        foreach (var item in Model.Data)
        {
            <div class="card">
                <h3>@item.UserProfileName</h3>

                <div class="meta" style="color: #666; margin-bottom: 15px;">
                    @item.JobTitle &nbsp;|&nbsp; @item.CreatedAt.ToString("yyyy-MM-dd")
                </div>

                <div style="margin-bottom: 12px;">
                    <span class="badge">@item.Status</span>
                </div>

                <div style="display: flex; flex-wrap: wrap; gap: 8px; align-items: center;">
                    <form asp-action="ChangeStatus"
                          asp-route-id="@item.JobApplicationId"
                          asp-route-advertisementId="@advertisementId"
                          method="post"
                          style="display: flex; gap: 8px; align-items: center;">
                        @Html.AntiForgeryToken()

                        <select name="status" class="form-control" style="width: auto;">
                            @foreach (var status in statuses)
                            {
                                <option value="@status.Value"
                                        selected="@(status.Value == ((int)item.Status).ToString())">
                                    @status.Text
                                </option>
                            }
                        </select>

                        <button type="submit" class="btn">
                            Update Status
                        </button>
                    </form>

                    <a asp-action="ApplicantResume"
                       asp-route-id="@item.JobApplicationId"
                       class="btn">
                        View Applicant Resume
                    </a>
                </div>
            </div>
        }

        <partial name="_Pager" model="@Model" />
    }
</div>
