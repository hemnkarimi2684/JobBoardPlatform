@model JobApplicationMyViewModel

@{
    ViewData["Title"] = "My Job Applications";
}

<div class="page-head">
    <div>
        <h1 class="page-title">My Job Applications</h1>
        <p class="subtitle">Track the status of your applications.</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (Model.Data == null || Model.Data.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon">&#128203;</div>
        <h3>No applications yet</h3>
        <p>You have not submitted any applications yet.</p>
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Browse Jobs</a>
    </div>
}
else
{
    <div class="job-list">
        @foreach (var item in Model.Data)
        {
            <div class="card">
                <div class="card-between">
                    <h3 style="margin-bottom: 0;">@item.JobTitle</h3>
                    <span class="badge badge-outline">@item.Status</span>
                </div>

                <div class="meta" style="margin-top: 10px;">
                    @item.CompanyName
                    &nbsp;|&nbsp;
                    @item.CityName
                    &nbsp;|&nbsp;
                    @item.CreatedAt.ToString("yyyy-MM-dd")
                </div>

                <div class="job-badges">
                    <span class="badge">@item.CollaborationType</span>
                </div>

                @if (item.Status == JobApplicationStatus.Pending)
                {
                    <form asp-action="Cancel"
                          asp-route-id="@item.JobApplicationId"
                          method="post"
                          style="margin-top: 12px;">
                        @Html.AntiForgeryToken()

                        <button type="submit" class="btn btn-danger btn-sm">
                            Cancel Application
                        </button>
                    </form>
                }
            </div>
        }
    </div>

    <partial name="_Pager" model="@Model" />
}
