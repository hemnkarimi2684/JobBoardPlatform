@model Pagination<JobResponseDto>

@{
    ViewData["Title"] = "شغل‌ها";
    var text = ViewBag.Text as string;
}

<h2 style="margin-bottom: 18px; color: #1e3a5f;">شغل‌ها</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-success">@TempData["Error"]</div>
}

<div class="card" style="margin-bottom: 20px;">
    <form asp-action="Index" method="get" style="display: flex; gap: 10px; align-items: flex-end;">
        <div class="form-group" style="flex: 1; margin-bottom: 0;">
            <label for="text">جستجوی شغل</label>
            <input type="text" id="text" name="text" class="form-control" value="@text" placeholder="نام شغل..." />
        </div>
        <button type="submit" class="btn">جستجو</button>
    </form>
</div>

@if (Model.Data.Count == 0)
{
    <div class="empty">شغلی یافت نشد.</div>
}
else
{
    foreach (var item in Model.Data)
    {
        <div class="card" style="display: flex; justify-content: space-between; align-items: center;">
            <h3 style="margin-bottom: 0;">@item.Name</h3>
            <a class="btn" asp-action="Details" asp-route-id="@item.JobId">مشاهده آگهی‌ها</a>
        </div>
    }

    @await Html.PartialAsync("_Pager", Model)
}
