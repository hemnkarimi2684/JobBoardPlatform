@model JobIndexViewModel

@{
    ViewData["Title"] = "Jobs";
    // Retrieve the search text from ViewBag, defaulting to empty string if not present.
    var searchText = ViewBag.Text as string ?? "";
}

<div class="page-head">
    <h1 class="page-title">Jobs</h1>
    <p class="subtitle">Browse job positions and find the right fit for you.</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="panel">
    <form asp-action="Index" method="get" class="search-row">
        <div class="search-box" style="flex: 1;">
            <span class="search-icon">&#128269;</span>
            <input type="text" id="searchText" name="text" class="search-input" value="@searchText" placeholder="Job title..." />
        </div>
        <button type="submit" class="btn btn-primary">Search</button>
    </form>
</div>

@if (Model.Data.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon">&#128269;</div>
        <h3>No jobs found</h3>
        <p>Try a different search term or browse all jobs.</p>
    </div>
}
else
{
    <div class="job-list">
        @foreach (var item in Model.Data)
        {
            <div class="card card-hover card-between">
                <h3 style="margin-bottom: 0;">@item.Name</h3>
                <a class="btn btn-outline" asp-action="Details" asp-route-id="@item.JobId">View Ads</a>
            </div>
        }
    </div>

    @await Html.PartialAsync("_Pager", Model)
}
