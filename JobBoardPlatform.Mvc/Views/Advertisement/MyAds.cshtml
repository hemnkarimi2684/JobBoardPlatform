@model Pagination<AdvertisementDetailResponseDto>

@{
    ViewData["Title"] = "My Advertisements";
}

<div style="direction: ltr; text-align: left;">
    <h2 style="margin-bottom: 18px; color: #1e3a5f;">My Advertisements</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div style="margin-bottom: 18px; display: flex; gap: 10px;">
        <a class="btn" asp-action="Create">Post New Advertisement</a>
        <a class="btn" asp-action="Index" style="background:#667;">Back to Job Board</a>
        <a class="btn" asp-action="Filter" style="background:#667;">Filter Advertisements</a>
    </div>

    @if (Model.Data.Count == 0)
    {
        <div class="empty">You have not posted any advertisements yet.</div>
    }
    else
    {
        foreach (var item in Model.Data)
        {
            <div class="card">
                <h3>@item.JobName</h3>
                <div class="meta" style="color: #666; margin-bottom: 10px;">
                    @item.CompanyName &nbsp;|&nbsp; @item.CityName &nbsp;|&nbsp; @item.CreatedAt.ToString("yyyy/MM/dd")
                </div>
                <div style="margin-bottom: 10px;">
                    <span class="badge">@item.CollaborationType</span>
                    <span class="badge">Experience: @item.ExperienceLevel years</span>
                    @if (item.IsFeatured)
                    {
                        <span class="badge">Featured</span>
                    }
                </div>
                <p style="margin: 10px 0; color: #445;">
                    @(item.Description.Length > 120 ? item.Description.Substring(0, 120) + "..." : item.Description)
                </p>
                <a class="btn" asp-action="Details" asp-route-id="@item.AdvertisementId">Details</a>
                <a class="btn" asp-action="Edit" asp-route-id="@item.AdvertisementId" style="background:#667;">Edit</a>
            </div>
        }

        @await Html.PartialAsync("_Pager", Model)
    }
</div>
