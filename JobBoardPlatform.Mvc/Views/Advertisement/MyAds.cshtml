@model Pagination<AdvertisementDetailResponseDto>

@{
    ViewData["Title"] = "آگهی‌های من";
}

<h2 style="margin-bottom: 18px; color: #1e3a5f;">آگهی‌های من</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-success">@TempData["Error"]</div>
}

<div style="margin-bottom: 18px; display: flex; gap: 10px;">
    <a class="btn" asp-action="Create">ثبت آگهی جدید</a>
    <a class="btn" asp-action="Index" style="background:#667;">بازگشت به آگهی‌های شغلی</a>
    <a class="btn" asp-action="Filter" style="background:#667;">فیلتر آگهی‌ها</a>
</div>

@if (Model.Data.Count == 0)
{
    <div class="empty">هنوز آگهی‌ای ثبت نکرده‌اید.</div>
}
else
{
    foreach (var item in Model.Data)
    {
        <div class="card">
            <h3>@item.JobName</h3>
            <div class="meta">
                @item.CompanyName &nbsp;|&nbsp; @item.CityName &nbsp;|&nbsp; @item.CreatedAt.ToString("yyyy/MM/dd")
            </div>
            <div>
                <span class="badge">@item.CollaborationType</span>
                <span class="badge">سطح: @item.ExperienceLevel</span>
                @if (item.IsFeatured)
                {
                    <span class="badge">ویژه</span>
                }
            </div>
            <p style="margin: 10px 0; color: #445;">@(item.Description.Length > 120 ? item.Description.Substring(0, 120) + "..." : item.Description)</p>
            <a class="btn" asp-action="Details" asp-route-id="@item.AdvertisementId">جزئیات</a>
            <a class="btn" asp-action="Edit" asp-route-id="@item.AdvertisementId" style="background:#667;">ویرایش</a>
        </div>
    }

    @await Html.PartialAsync("_Pager", Model)
}
