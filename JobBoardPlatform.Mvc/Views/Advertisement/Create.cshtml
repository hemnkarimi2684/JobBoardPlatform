@model CreateAdvertisementRequestDto

@{
    ViewData["Title"] = "ثبت آگهی جدید";
}

<h2 style="margin-bottom: 18px; color: #1e3a5f;">ثبت آگهی جدید</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-success">@TempData["Error"]</div>
}

<div class="card">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="detail-grid">
            <div class="form-group">
                <label asp-for="JobId">عنوان شغلی</label>
                <select asp-for="JobId" asp-items="@ViewBag.Jobs" class="form-control">
                    <option value="">انتخاب کنید</option>
                </select>
                <span asp-validation-for="JobId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="CityId">شهر</label>
                <select asp-for="CityId" asp-items="@ViewBag.Cities" class="form-control">
                    <option value="">انتخاب کنید</option>
                </select>
                <span asp-validation-for="CityId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="CollaborationType">نوع همکاری</label>
                <select asp-for="CollaborationType" class="form-control">
                    <option value="">انتخاب کنید</option>
                    @foreach (var type in ViewBag.CollaborationTypes)
                    {
                        <option value="@type.Value">@type.Text</option>
                    }
                </select>
                <span asp-validation-for="CollaborationType" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ExperienceLevel">سطح تجربه</label>
                <input asp-for="ExperienceLevel" class="form-control" type="number" />
                <span asp-validation-for="ExperienceLevel" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MinimumAge">حداقل سن</label>
                <input asp-for="MinimumAge" class="form-control" type="number" />
                <span asp-validation-for="MinimumAge" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MaximumAge">حداکثر سن</label>
                <input asp-for="MaximumAge" class="form-control" type="number" />
                <span asp-validation-for="MaximumAge" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MinimumSalary">حداقل حقوق</label>
                <input asp-for="MinimumSalary" class="form-control" />
                <span asp-validation-for="MinimumSalary" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MaximumSalary">حداکثر حقوق</label>
                <input asp-for="MaximumSalary" class="form-control" />
                <span asp-validation-for="MaximumSalary" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Description">توضیحات</label>
            <textarea asp-for="Description" class="form-control" rows="6" placeholder="توضیحات کامل آگهی (حداقل ۱۰۰ کاراکتر)..."></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>مهارت‌های مورد نیاز</label>
            <div>
                @foreach (var skill in ViewBag.Skills)
                {
                    <label style="display:inline-block; margin-left:14px; margin-bottom:8px;">
                        <input type="checkbox" name="SkillsId" value="@skill.Value" />
                        @skill.Text
                    </label>
                }
            </div>
            <span asp-validation-for="SkillsId" class="text-danger"></span>
        </div>

        <input type="hidden" name="CompanyId" value="@ViewBag.DefaultCompanyId" />

        <button type="submit" class="btn">ثبت آگهی</button>
        <a class="btn" asp-action="MyAds" style="background:#667;">انصراف</a>
    </form>
</div>
