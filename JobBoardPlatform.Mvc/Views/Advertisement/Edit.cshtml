@model AdvertisementEditViewModel

@{
    ViewData["Title"] = "Edit Advertisement";
    var routeId = ViewContext.RouteData.Values["id"];
}

<div class="page-head">
    <div>
        <h1 class="page-title">Edit Advertisement</h1>
        <p class="subtitle">Update the details of your job advertisement.</p>
    </div>
    <a class="btn btn-ghost" asp-action="MyAds">&#8592; Back to My Ads</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card">
    <form asp-action="Edit" asp-route-id="@routeId" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@routeId" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="detail-grid">
            <div class="form-group">
                <label asp-for="CollaborationType">Collaboration Type</label>
                <select name="CollaborationType" class="form-control">
                    <option value="">Select Type</option>
                    @foreach (var type in ViewBag.CollaborationTypes)
                    {
                        if (Model.CollaborationType.HasValue && (int)Model.CollaborationType.Value == int.Parse(type.Value))
                        {
                            <option value="@type.Value" selected="selected">@type.Text</option>
                        }
                        else
                        {
                            <option value="@type.Value">@type.Text</option>
                        }
                    }
                </select>
                <span asp-validation-for="CollaborationType" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ExperienceLevel">Experience Level (Years)</label>
                <input asp-for="ExperienceLevel" class="form-control" type="number" />
                <span asp-validation-for="ExperienceLevel" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MinimumAge">Minimum Age</label>
                <input asp-for="MinimumAge" class="form-control" type="number" />
                <span asp-validation-for="MinimumAge" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MaximumAge">Maximum Age</label>
                <input asp-for="MaximumAge" class="form-control" type="number" />
                <span asp-validation-for="MaximumAge" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MinimumSalary">Minimum Salary</label>
                <input asp-for="MinimumSalary" class="form-control" />
                <span asp-validation-for="MinimumSalary" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MaximumSalary">Maximum Salary</label>
                <input asp-for="MaximumSalary" class="form-control" />
                <span asp-validation-for="MaximumSalary" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Description">Description</label>
            <textarea asp-for="Description" class="form-control" rows="6" placeholder="Full job description (at least 100 characters)..."></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div style="margin-top: 20px; display:flex; gap:10px; flex-wrap:wrap;">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a class="btn btn-ghost" asp-action="MyAds">Cancel</a>
        </div>
    </form>
</div>
