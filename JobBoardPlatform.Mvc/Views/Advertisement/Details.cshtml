@model AdvertisementDetailResponseDto

@{
    ViewData["Title"] = Model.JobName;
}

<div style="direction: ltr; text-align: left;">
    <div class="card">
        <h3>@Model.JobName</h3>

        <div class="meta">
            @Model.CompanyName &nbsp;|&nbsp;
            @Model.CityName &nbsp;|&nbsp;
            @Model.CreatedAt.ToString("yyyy/MM/dd")
        </div>

        <div style="margin-bottom: 14px;">
            <span class="badge">@Model.CollaborationType</span>
            <span class="badge">Experience: @Model.ExperienceLevel years</span>

            @if (Model.IsFeatured)
            {
                <span class="badge">Featured</span>
            }
        </div>

        <div class="detail-grid">
            <div>
                <span>Minimum Age</span>
                @Model.MinimumAge years
            </div>

            <div>
                <span>Maximum Age</span>
                @Model.MaximumAge years
            </div>

            <div>
                <span>Minimum Salary</span>
                @Model.MinimumSalary.ToString("N0")
            </div>

            <div>
                <span>Maximum Salary</span>
                @Model.MaximumSalary.ToString("N0")
            </div>

            <div>
                <span>Category</span>
                @Model.CompanyJobCategoryName
            </div>

            <div>
                <span>About Company</span>
                @Model.AboutCompany
            </div>
        </div>

        <h4 style="margin:16px 0 8px; color:#1e3a5f;">
            Job Description
        </h4>

        <p style="line-height:1.8;">
            @Model.Description
        </p>

        @if (Model.SkillNames != null && Model.SkillNames.Any())
        {
            <h4 style="margin:16px 0 8px; color:#1e3a5f;">
                Required Skills
            </h4>

            <div>
                @foreach (var skill in Model.SkillNames)
                {
                    <span class="skill">@skill</span>
                }
            </div>
        }

        <div style="margin-top:18px; display:flex; gap:10px; align-items:center;">

            @if (User.IsInRole("JobSeeker"))
            {
                <form asp-controller="JobApplication"
                      asp-action="Apply"
                      method="post"
                      style="margin:0;">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="advertisementId"
                           value="@Model.AdvertisementId" />

                    <button type="submit"
                            class="btn"
                            style="background-color:#28a745;color:white;">
                        Apply for this Job
                    </button>
                </form>
            }

            <a class="btn" asp-action="Index">
                Back to List
            </a>

        </div>
    </div>
</div>
