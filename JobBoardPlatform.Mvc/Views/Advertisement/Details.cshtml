@model AdvertisementDetailsViewModel

@{
    ViewData["Title"] = Model.JobName;
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" style="margin:1rem 1.5rem;">@TempData["Error"]</div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" style="margin:1rem 1.5rem;">@TempData["Success"]</div>
}

<div class="detail-hero">
    <div class="detail-hero-main">
        @if (Model.CompanyImageFileId.HasValue)
        {
            <div class="detail-hero-icon" style="background:#fff; padding:8px; box-sizing:border-box;">
                <img src="@Url.Action("DownloadImage", "Company", new { id = Model.CompanyId })" alt="@Model.CompanyName" style="width:100%; height:100%; object-fit:contain; border-radius:8px;" />
            </div>
        }
        else
        {
            <div class="detail-hero-icon">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 0 0 .75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 0 0-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0 1 12 15c-2.743 0-5.357-.467-7.827-1.47-.254-.085-.48-.215-.673-.38m0 0A2.18 2.18 0 0 1 3 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 0 1 3.413-.387m16.5 0V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 0 0-3.413-.387m-7.5 0a48.114 48.114 0 0 1 3.413-.387m-7.5 0c.106.97.505 1.85 1.162 2.554m-1.162-2.554a11.986 11.986 0 0 0-4.252.06M18 4.5A3 3 0 0 1 21 7.5m-3-3A3 3 0 0 0 15 7.5m3-3A3 3 0 0 1 18 7.5" /></svg>
            </div>
        }
        <div style="min-width: 0;">
            <h1 class="detail-hero-title">@Model.JobName</h1>
            <div class="detail-hero-meta">
                <span>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21" /></svg>
                    @Model.CompanyName
                </span>
                <span>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" /></svg>
                    @Model.CityName
                </span>
                <span>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" /></svg>
                    Posted @Model.CreatedAt.ToString("yyyy/MM/dd")
                </span>
                <span>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Z" /></svg>
                    @Model.CompanyJobCategoryName
                </span>
            </div>
        </div>
    </div>
    <div class="detail-hero-actions">
        @if (User.IsInRole("JobSeeker"))
        {
            @if (Model.Status == JobBoardPlatform.Core.Entities.AdvertisementEntity.Enums.AdvertisementStatus.Open)
            {
                <form asp-controller="JobApplication" asp-action="Apply" method="post" onsubmit="return confirm('Are you sure you want to apply for this job?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="advertisementId" value="@Model.AdvertisementId" />
                    <button type="submit" class="btn btn-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" width="16" height="16"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                        Apply for this Job
                    </button>
                </form>
            }
            else
            {
                <div class="alert alert-danger" style="margin-bottom:0;">This position has been filled and is no longer accepting applications.</div>
            }
        }
        @if (User.IsInRole("Employer") && Model.IsOwner)
        {
            <a class="btn btn-primary"
               asp-controller="JobApplication"
               asp-action="ByAdvertisement"
               asp-route-advertisementId="@Model.AdvertisementId">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" width="16" height="16"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m-6-8h6m-9 12h12a2.25 2.25 0 0 0 2.25-2.25V6A2.25 2.25 0 0 0 18 3.75H6A2.25 2.25 0 0 0 3.75 6v12A2.25 2.25 0 0 0 6 21Z" /></svg>
                View Applications
            </a>
            <a class="btn btn-ghost"
               asp-controller="Payment"
               asp-action="Feature"
               asp-route-advertisementId="@Model.AdvertisementId">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" width="16" height="16"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v17m0 0c-1.5 0-4-2-4-4h8c0 2-2.5 4-4 4Zm-7-9h14" /></svg>
                @if (Model.IsFeatured)
                {
                    <text>Extend Featured</text>
                }
                else
                {
                    <text>Feature This Advertisement</text>
                }
            </a>
        }
        <a class="btn btn-ghost" asp-action="Index">&#8592; Back to List</a>
    </div>
</div>

<div class="job-badges" style="margin-bottom: 8px;">
    <span class="badge">@Model.CollaborationType</span>
    @if (Model.ExperienceLevel > 0)
    {
        <span class="badge badge-outline">@Model.ExperienceLevel yrs exp</span>
    }
    @if (Model.IsFeatured)
    {
        <span class="badge badge-featured">Featured</span>
    }
    @if (Model.Status == JobBoardPlatform.Core.Entities.AdvertisementEntity.Enums.AdvertisementStatus.Closed)
    {
        <span class="badge badge-danger">Closed</span>
    }
</div>

<div class="panel" style="margin-top: 10px;">
    <div class="panel-head">
        <h3>Job Overview</h3>
    </div>
    <div class="detail-grid">
        <div class="detail-item">
            <span class="detail-label">Minimum Age</span>
            <span class="detail-value">@Model.MinimumAge years</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Maximum Age</span>
            <span class="detail-value">@Model.MaximumAge years</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Minimum Salary</span>
            <span class="detail-value">@Model.MinimumSalary.ToString("N0")</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Maximum Salary</span>
            <span class="detail-value">@Model.MaximumSalary.ToString("N0")</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Category</span>
            <span class="detail-value">@Model.CompanyJobCategoryName</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Company</span>
            <span class="detail-value">@Model.CompanyName</span>
        </div>
    </div>
</div>

<section class="panel">
    <div class="panel-head">
        <h3>Job Description</h3>
    </div>
    <p style="line-height: 1.8; white-space: pre-line;">@Model.Description</p>

    @if (Model.SkillNames != null && Model.SkillNames.Any())
    {
        <h3 style="margin: 20px 0 10px; font-size: 1rem;">Required Skills</h3>
        <div class="chips">
            @foreach (var skill in Model.SkillNames)
            {
                <span class="chip">@skill</span>
            }
        </div>
    }
</section>

@if (Model.AboutCompany != null)
{
    <section class="panel">
        <div class="panel-head">
            <h3>About the Company</h3>
        </div>
        <p style="white-space: pre-line;">@Model.AboutCompany</p>
    </section>
}
