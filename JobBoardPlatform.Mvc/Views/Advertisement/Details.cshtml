@model AdvertisementDetailsViewModel

@{
    ViewData["Title"] = Model.JobName;
}

<div class="page-head">
    <div>
        <h2>@Model.JobName</h2>
        <p class="muted">@Model.CompanyName &middot; @Model.CityName &middot; Posted on @Model.CreatedAt.ToString("yyyy/MM/dd")</p>
    </div>
    <a class="btn btn-ghost" asp-action="Index">&#8592; Back to List</a>
</div>

<section class="panel">
    <div class="job-badges" style="margin-bottom: 8px;">
        <span class="badge">@Model.CollaborationType</span>
        @if (Model.ExperienceLevel > 0)
        {
            <span class="badge badge-outline">@Model.ExperienceLevel yrs exp</span>
        }
        @if (Model.IsFeatured)
        {
            <span class="badge badge-featured">Featured</span>
        }
    </div>

    <div class="detail-grid">
        <div class="detail-item">
            <span class="detail-label">Minimum Age</span>
            <span class="detail-value">@Model.MinimumAge years</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Maximum Age</span>
            <span class="detail-value">@Model.MaximumAge years</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Minimum Salary</span>
            <span class="detail-value">@Model.MinimumSalary.ToString("N0")</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Maximum Salary</span>
            <span class="detail-value">@Model.MaximumSalary.ToString("N0")</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Category</span>
            <span class="detail-value">@Model.CompanyJobCategoryName</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Company</span>
            <span class="detail-value">@Model.CompanyName</span>
        </div>
    </div>
</section>

<section class="panel">
    <div class="panel-head">
        <h3>Job Description</h3>
    </div>
    <p style="line-height: 1.8; white-space: pre-line;">@Model.Description</p>

    @if (Model.SkillNames != null && Model.SkillNames.Any())
    {
        <h3 style="margin: 20px 0 10px; font-size: 1rem;">Required Skills</h3>
        <div class="chips">
            @foreach (var skill in Model.SkillNames)
            {
                <span class="chip">@skill</span>
            }
        </div>
    }
</section>

@if (Model.AboutCompany != null)
{
    <section class="panel">
        <div class="panel-head">
            <h3>About the Company</h3>
        </div>
        <p style="white-space: pre-line;">@Model.AboutCompany</p>
    </section>
}

<div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
    @if (User.IsInRole("JobSeeker"))
    {
        <form asp-controller="JobApplication" asp-action="Apply" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="advertisementId" value="@Model.AdvertisementId" />
            <button type="submit" class="btn btn-primary">Apply for this Job</button>
        </form>
    }

    @if (User.IsInRole("Employer") && Model.IsOwner)
    {
        <a class="btn btn-primary"
           asp-controller="JobApplication"
           asp-action="ByAdvertisement"
           asp-route-advertisementId="@Model.AdvertisementId">
            View Applications
        </a>
    }
</div>
