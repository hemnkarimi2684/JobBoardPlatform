@model Pagination<AdvertisementDetailResponseDto>

@{
    ViewData["Title"] = "جستجو در آگهی‌ها";
    var searchTerm = ViewBag.SearchTerm as string;
}

<h2 style="margin-bottom: 18px; color: #1e3a5f;">جستجو در آگهی‌ها</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-success">@TempData["Error"]</div>
}

<div class="card" style="margin-bottom: 20px;">
    <form asp-action="Search" method="get" style="display: flex; gap: 10px; align-items: flex-end;">
        <div class="form-group" style="flex: 1; margin-bottom: 0;">
            <label for="searchTerm">عبارت جستجو</label>
            <input type="text" id="searchTerm" name="searchTerm" class="form-control" value="@searchTerm" placeholder="عنوان آگهی، شرکت یا شهر..." />
        </div>
        <button type="submit" class="btn">جستجو</button>
    </form>
</div>

@if (Model.Data.Count == 0)
{
    <div class="empty">نتیجه‌ای برای جستجوی شما یافت نشد.</div>
}
else
{
    foreach (var item in Model.Data)
    {
        <div class="card">
            <h3>@item.JobName</h3>
            <div class="meta">
                @item.CompanyName &nbsp;|&nbsp; @item.CityName &nbsp;|&nbsp; @item.CreatedAt.ToString("yyyy/MM/dd")
            </div>
            <div>
                <span class="badge">@item.CollaborationType</span>
                <span class="badge">سطح: @item.ExperienceLevel</span>
                @if (item.IsFeatured)
                {
                    <span class="badge">ویژه</span>
                }
            </div>
            <p style="margin: 10px 0; color: #445;">@(item.Description.Length > 120 ? item.Description.Substring(0, 120) + "..." : item.Description)</p>
            <a class="btn" asp-action="Details" asp-route-id="@item.AdvertisementId">جزئیات</a>
        </div>
    }

    @await Html.PartialAsync("_Pager", Model)
}
