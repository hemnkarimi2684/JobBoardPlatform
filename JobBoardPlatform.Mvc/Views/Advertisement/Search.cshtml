@model Pagination<AdvertisementDetailResponseDto>

@{
    ViewData["Title"] = "Search Job Advertisements";
    var searchTerm = ViewBag.SearchTerm as string;
}

<div style="direction: ltr; text-align: left;">
    <h2 style="margin-bottom: 18px; color: #1e3a5f;">Search Job Advertisements</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card" style="margin-bottom: 20px;">
        <form asp-action="Search" method="get" style="display: flex; gap: 10px; align-items: flex-end;">
            <div class="form-group" style="flex: 1; margin-bottom: 0;">
                <label for="searchTerm">Search Term</label>
                <input type="text" id="searchTerm" name="searchTerm" class="form-control" value="@searchTerm" placeholder="Search by job title, company, or city..." />
            </div>
            <button type="submit" class="btn">Search</button>
        </form>
    </div>

    @if (Model.Data.Count == 0)
    {
        <div class="empty">No results found for your search query.</div>
    }
    else
    {
        foreach (var item in Model.Data)
        {
            <div class="card">
                <h3>@item.JobName</h3>
                <div class="meta" style="color: #666; margin-bottom: 10px;">
                    @item.CompanyName &nbsp;|&nbsp; @item.CityName &nbsp;|&nbsp; @item.CreatedAt.ToString("yyyy/MM/dd")
                </div>
                <div style="margin-bottom: 10px;">
                    <span class="badge">@item.CollaborationType</span>
                    <span class="badge">Experience: @item.ExperienceLevel years</span>
                    @if (item.IsFeatured)
                    {
                        <span class="badge">Featured</span>
                    }
                </div>
                <p style="margin: 10px 0; color: #445;">
                    @(item.Description.Length > 120 ? item.Description.Substring(0, 120) + "..." : item.Description)
                </p>
                <a class="btn" asp-action="Details" asp-route-id="@item.AdvertisementId">View Details</a>
            </div>
        }

        @await Html.PartialAsync("_Pager", Model)
    }
</div>
