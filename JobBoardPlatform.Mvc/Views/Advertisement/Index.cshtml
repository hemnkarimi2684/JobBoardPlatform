@model Pagination<AdvertisementDetailResponseDto>

@{
    ViewData["Title"] = "Job Advertisements";
}

<div style="direction: ltr; text-align: left;">
    <h2 style="margin-bottom: 18px; color: #1e3a5f;">Active Job Advertisements</h2>

    @if (Model.Data.Count == 0)
    {
        <div class="empty">There are no active advertisements at the moment.</div>
    }
    else
    {
        foreach (var item in Model.Data)
        {
            <div class="card">
                <h3>@item.JobName</h3>
                <div class="meta" style="color: #666; margin-bottom: 10px;">
                    @item.CompanyName &nbsp;|&nbsp; @item.CityName &nbsp;|&nbsp; @item.CreatedAt.ToString("yyyy/MM/dd")
                </div>
                <div style="margin-bottom: 10px;">
                    <span class="badge">@item.CollaborationType</span>
                    <span class="badge">Experience: @item.ExperienceLevel years</span>
                    @if (item.IsFeatured)
                    {
                        <span class="badge">Featured</span>
                    }
                </div>
                <p style="margin: 10px 0; color: #445;">
                    @(item.Description.Length > 120 ? item.Description.Substring(0, 120) + "..." : item.Description)
                </p>
                <a class="btn" asp-action="Details" asp-route-id="@item.AdvertisementId">View Details</a>
            </div>
        }

        <div class="pager" style="margin-top: 20px; display: flex; align-items: center; gap: 10px;">
            @if (Model.PageNumber > 1)
            {
                <a asp-action="Index" asp-route-pageNumber="@(Model.PageNumber - 1)" class="btn-pager">Previous</a>
            }

            <span class="current">Page @Model.PageNumber of @Model.TotalPageCount</span>

            @if (Model.PageNumber < Model.TotalPageCount)
            {
                <a asp-action="Index" asp-route-pageNumber="@(Model.PageNumber + 1)" class="btn-pager">Next</a>
            }
        </div>
    }
</div>
