@model object
@{
    var pager = (dynamic)Model;
    var pageNumber = (int)pager.PageNumber;
    var totalPages = (int)pager.TotalPageCount;
}
@if (totalPages > 1)
{
    <nav class="pager">
        @if (pageNumber > 1)
        {
            var prevQuery = Context.Request.Query.ToDictionary(x => x.Key, x => x.Value.ToString());
            prevQuery["pageNumber"] = (pageNumber - 1).ToString();
            var prevUrl = Context.Request.Path + "?" + string.Join("&", prevQuery.Select(x => x.Key + "=" + x.Value));
            <a class="pager-link" href="@prevUrl">&#8592; Previous</a>
        }
        <span class="pager-current">Page @pageNumber of @totalPages</span>
        @if (pageNumber < totalPages)
        {
            var nextQuery = Context.Request.Query.ToDictionary(x => x.Key, x => x.Value.ToString());
            nextQuery["pageNumber"] = (pageNumber + 1).ToString();
            var nextUrl = Context.Request.Path + "?" + string.Join("&", nextQuery.Select(x => x.Key + "=" + x.Value));
            <a class="pager-link" href="@nextUrl">Next &#8594;</a>
        }
    </nav>
}
