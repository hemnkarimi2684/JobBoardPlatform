@model EmployerWithCompanyResponseDto

@{
    ViewData["Title"] = "شرکت من";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert" style="background:#fdecea;color:#a43d3d;border:1px solid #f5c6cb;">@TempData["Error"]</div>
}

<div class="card">
    <h3>@Model.Name</h3>
    <div class="meta">
        @Model.Email &nbsp;|&nbsp; @Model.PhoneNumber
    </div>

    <div class="detail-grid">
        <div><span>سال تأسیس</span> @Model.YearOfEstablishment.ToString("yyyy")</div>
        <div><span>وب‌سایت</span> @Model.WebSiteAddress</div>
        <div><span>نوع مالکیت</span> @Model.OwnershipType</div>
        <div><span>اندازه شرکت</span> @Model.CompanySize</div>
        <div><span>دسته‌بندی</span> @Model.JobCategoryName</div>
        <div><span>نوع فعالیت</span> @Model.ActivityType</div>
    </div>

    <h4 style="margin: 16px 0 8px; color: #1e3a5f;">درباره شرکت</h4>
    <p style="line-height: 1.8;">@Model.AboutUs</p>

    <div style="margin-top: 18px;">
        <a class="btn" asp-action="Edit" asp-route-id="@Model.CompanyId">ویرایش اطلاعات</a>
    </div>
</div>

<div class="card">
    <h3>لوگوی شرکت</h3>

    @if (Model.CompanyImageFileId.HasValue)
    {
        <img src="@Url.Action("DownloadImage", "Company", new { id = Model.CompanyId })" alt="@Model.Name" style="max-width:180px;border-radius:8px;margin-bottom:12px;" />
    }
    else
    {
        <p class="meta">لوگویی برای شرکت ثبت نشده است.</p>
    }

    <form asp-action="UploadImage" asp-route-id="@Model.CompanyId" method="post" enctype="multipart/form-data" style="margin-top: 12px;">
        <div class="form-group">
            <label>لوگوی جدید</label>
            <input type="file" name="Image" class="form-control" />
        </div>
        <button type="submit" class="btn">آپلود لوگو</button>
    </form>

    @if (Model.CompanyImageFileId.HasValue)
    {
        <form asp-action="DeleteImage" asp-route-id="@Model.CompanyId" method="post" style="margin-top: 12px;">
            <button type="submit" class="btn">حذف لوگو</button>
        </form>
    }
</div>
