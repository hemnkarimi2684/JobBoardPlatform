@model CompanyDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
}

<div class="page-head">
    <div>
        <h1 class="page-title">@Model.Name</h1>
        <p class="subtitle">@Model.JobCategoryName</p>
    </div>
    <a class="btn btn-ghost" asp-action="Index">&#8592; Back to List</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<section class="panel">
    @if (Model.CompanyImageFileId.HasValue)
    {
        <img src="@Url.Action("DownloadImage", "Company", new { id = Model.Id })" alt="@Model.Name" class="company-logo" />
    }

    <div class="detail-grid">
        <div class="detail-item">
            <span class="detail-label">Established In</span>
            <span class="detail-value">@Model.YearOfEstablishment.ToString("yyyy")</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Website</span>
            <span class="detail-value">
                @if (!string.IsNullOrWhiteSpace(Model.WebSiteAddress))
                {
                    <a href="@(Model.WebSiteAddress.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? Model.WebSiteAddress : "https://" + Model.WebSiteAddress)" target="_blank">@Model.WebSiteAddress</a>
                }
                else
                {
                    <span>-</span>
                }
            </span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Ownership Type</span>
            <span class="detail-value">@Model.OwnershipType</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Company Size</span>
            <span class="detail-value">@Model.CompanySize</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Category</span>
            <span class="detail-value">@Model.JobCategoryName</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Activity Type</span>
            <span class="detail-value">@Model.ActivityType</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Active Cities Count</span>
            <span class="detail-value">@Model.Cities.Count</span>
        </div>
    </div>
</section>

<section class="panel">
    <div class="panel-head">
        <h3>About Company</h3>
    </div>
    <p style="line-height: 1.8; white-space: pre-line;">@Model.AboutUs</p>
</section>
