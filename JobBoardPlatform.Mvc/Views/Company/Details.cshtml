@model CompanyDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="detail-hero">
    <div class="detail-hero-main">
        @if (Model.CompanyImageFileId.HasValue)
        {
            <div class="detail-hero-icon" style="background:#fff; padding:8px; box-sizing:border-box;">
                <img src="@Url.Action("DownloadImage", "Company", new { id = Model.Id })" alt="@Model.Name" style="width:100%; height:100%; object-fit:contain; border-radius:8px;" />
            </div>
        }
        else
        {
            <div class="detail-hero-icon">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21" /></svg>
            </div>
        }
        <div style="min-width: 0;">
            <h1 class="detail-hero-title">@Model.Name</h1>
            <div class="detail-hero-meta">
                <span>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6Z" /></svg>
                    @Model.JobCategoryName
                </span>
                <span>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Z" /></svg>
                    Established @Model.YearOfEstablishment.ToString("yyyy")
                </span>
                @if (!string.IsNullOrWhiteSpace(Model.WebSiteAddress))
                {
                    <span>
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244" /></svg>
                        <a href="@(Model.WebSiteAddress.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? Model.WebSiteAddress : "https://" + Model.WebSiteAddress)" target="_blank">@Model.WebSiteAddress</a>
                    </span>
                }
            </div>
        </div>
    </div>
    <div class="detail-hero-actions">
        <a class="btn btn-ghost" asp-action="Index">&#8592; Back to List</a>
    </div>
</div>

<section class="panel">
    <div class="panel-head">
        <h3>Company Overview</h3>
    </div>
    <div class="detail-grid">
        <div class="detail-item">
            <span class="detail-label">Established In</span>
            <span class="detail-value">@Model.YearOfEstablishment.ToString("yyyy")</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Website</span>
            <span class="detail-value">
                @if (!string.IsNullOrWhiteSpace(Model.WebSiteAddress))
                {
                    <a href="@(Model.WebSiteAddress.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? Model.WebSiteAddress : "https://" + Model.WebSiteAddress)" target="_blank">@Model.WebSiteAddress</a>
                }
                else
                {
                    <span>-</span>
                }
            </span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Ownership Type</span>
            <span class="detail-value">@Model.OwnershipType</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Company Size</span>
            <span class="detail-value">@Model.CompanySize</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Category</span>
            <span class="detail-value">@Model.JobCategoryName</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Activity Type</span>
            <span class="detail-value">@Model.ActivityType</span>
        </div>
        <div class="detail-item">
            <span class="detail-label">Active Cities Count</span>
            <span class="detail-value">@Model.Cities.Count</span>
        </div>
    </div>
</section>

<section class="panel">
    <div class="panel-head">
        <h3>About Company</h3>
    </div>
    <p style="line-height: 1.8; white-space: pre-line;">@Model.AboutUs</p>
</section>
