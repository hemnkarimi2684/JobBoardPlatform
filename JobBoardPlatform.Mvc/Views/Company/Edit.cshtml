@model CompanyEditViewModel

@{
    ViewData["Title"] = "Edit Company";
    var companyId = Context.Request.RouteValues["id"];
}

<div class="card auth-card" style="max-width: 620px;">
    <h3>Edit Company Information</h3>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form asp-action="Edit" asp-route-id="@companyId" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="Name">Company Name</label>
            <input asp-for="Name" class="form-control" placeholder="Enter company name" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="YearOfEstablishment">Year of Establishment</label>
            <input asp-for="YearOfEstablishment" class="form-control" />
            <span asp-validation-for="YearOfEstablishment" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="AboutUs">About Us</label>
            <textarea asp-for="AboutUs" class="form-control" rows="5" placeholder="About us (minimum 50 characters)"></textarea>
            <span asp-validation-for="AboutUs" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="WebSiteAddress">Website Address</label>
            <input asp-for="WebSiteAddress" class="form-control" placeholder="e.g., www.company.com" />
            <span asp-validation-for="WebSiteAddress" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="OwnershipType">Ownership Type</label>
            <select asp-for="OwnershipType" asp-items="ViewBag.OwnershipTypes" class="form-control">
                <option value="">-- Select Ownership Type --</option>
            </select>
            <span asp-validation-for="OwnershipType" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="CompanySize">Company Size</label>
            <select asp-for="CompanySize" asp-items="ViewBag.CompanySizes" class="form-control">
                <option value="">-- Select Company Size --</option>
            </select>
            <span asp-validation-for="CompanySize" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="JobCategoryId">Industry / Category</label>
            <select asp-for="JobCategoryId" asp-items="ViewBag.JobCategories" class="form-control">
                <option value="">-- Select Category --</option>
            </select>
            <span asp-validation-for="JobCategoryId" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="ActivityType">Activity Type</label>
            <input asp-for="ActivityType" class="form-control" placeholder="e.g., Software Development (Optional)" />
            <span asp-validation-for="ActivityType" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Save Changes</button>
    </form>
</div>
